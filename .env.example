# Copy to .env for local builds, and set the same keys in Cloudflare Pages → Settings → Environment variables.
#
# Marketplace split (production):
# - Preferred long-term: TWO Cloudflare Pages projects with PUBLIC_SITE_REGION=ca|us
# - Current shared project also uses functions/_middleware.js so that
#   uspickleballcourt.com rewrites Amazon.ca links/tags to Amazon.com / uspickleball-20
#   while thepickleballcourt.ca is left unchanged.
#
# Project A (Canada): PUBLIC_SITE_REGION=ca
#   Domains: thepickleballcourt.ca, www.thepickleballcourt.ca
# Project B (US, optional): PUBLIC_SITE_REGION=us
#   Domains: uspickleballcourt.com, www.uspickleballcourt.com

# Site region: ca (default) or us
# CA → thepickleballcourt.ca + amazon.ca + thepickleb050-20
# US → uspickleballcourt.com + amazon.com + uspickleball-20
PUBLIC_SITE_REGION=ca

# Optional override (normally derived from PUBLIC_SITE_REGION)
# PUBLIC_SITE_URL=https://thepickleballcourt.ca

# Google Analytics 4 measurement ID (defaults to G-JWSBZJ6R4P in Analytics.astro)
# Shared by CA + US hostnames; filter in GA4 with the site_region event/user param (ca|us).
PUBLIC_GA_MEASUREMENT_ID=G-JWSBZJ6R4P

# Google Search Console HTML tag verification content value
PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Specialty affiliate partners (optional until approved) ---
# Selkirk via AvantLink (apply: https://www.selkirk.com/pages/selkirk-affiliate-program)
# After approval, copy Website ID (pw) + Selkirk Merchant ID (mi) from AvantLink.
PUBLIC_AVANTLINK_WEBSITE_ID=
PUBLIC_AVANTLINK_SELKIRK_MERCHANT_ID=
# Pickleball Superstore SuperAffiliate code (enroll: https://pickleballsuperstore.com/pages/superaffiliate-enrollment)
# Example format: Jane-12345678
PUBLIC_PICKLEBALL_SUPERSTORE_CODE=
