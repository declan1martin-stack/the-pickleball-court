# Copy to .env for local builds, and set the same keys in Cloudflare Pages → Settings → Environment variables.
#
# CRITICAL: Use TWO Cloudflare Pages projects (one build each). Never attach both
# custom domains to the same project — static HTML would share one marketplace/tag.
#
# Project A (Canada): PUBLIC_SITE_REGION=ca
#   Domains: thepickleballcourt.ca, www.thepickleballcourt.ca
# Project B (US): PUBLIC_SITE_REGION=us
#   Domains: uspickleballcourt.com, www.uspickleballcourt.com

# Site region: ca (default) or us
# CA → thepickleballcourt.ca + amazon.ca + thepickleb050-20
# US → uspickleballcourt.com + amazon.com + uspickleball-20
PUBLIC_SITE_REGION=ca

# Optional override (normally derived from PUBLIC_SITE_REGION)
# PUBLIC_SITE_URL=https://thepickleballcourt.ca

# Google Analytics 4 measurement ID (defaults to G-JWSBZJ6R4P in Analytics.astro)
PUBLIC_GA_MEASUREMENT_ID=G-JWSBZJ6R4P

# Google Search Console HTML tag verification content value
PUBLIC_GOOGLE_SITE_VERIFICATION=
