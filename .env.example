# Copy to .env for local builds, and set the same keys in Cloudflare Pages → Settings → Environment variables.

# Google Analytics 4 measurement ID (defaults to G-JWSBZJ6R4P in Analytics.astro)
PUBLIC_GA_MEASUREMENT_ID=G-JWSBZJ6R4P

# Google Search Console HTML tag verification content value
PUBLIC_GOOGLE_SITE_VERIFICATION=
