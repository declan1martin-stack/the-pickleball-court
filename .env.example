# Copy to .env for local builds, and set the same keys in Cloudflare Pages → Settings → Environment variables.
#
# Production (post CA→US consolidation):
# - Cloudflare Pages build command: npm run build  (defaults to PUBLIC_SITE_REGION=us)
# - Indexable host: uspickleballcourt.com
# - thepickleballcourt.ca uses a zone-level 301 Redirect Rule → uspickleballcourt.com
# - functions/_middleware.js is slim (www→apex, robots, verify stubs) — no HTML rewrite

# Site region: us (default) or ca
# US → uspickleballcourt.com + amazon.com + uspickleball-20
# CA → thepickleballcourt.ca + amazon.ca + thepickleb050-20 (legacy / local only)
PUBLIC_SITE_REGION=us

# Optional override (normally derived from PUBLIC_SITE_REGION)
# PUBLIC_SITE_URL=https://uspickleballcourt.com

# Google Analytics 4 (region-aware — see src/lib/analytics.ts)
# Code defaults: CA G-JWSBZJ6R4P, US G-WE9TTJLH00. Leave unset unless overriding.
# US Pages must never set G-JWSBZJ6R4P; CA Pages must never set G-WE9TTJLH00.
# Optional: PUBLIC_GA_MEASUREMENT_ID_US / PUBLIC_GA_MEASUREMENT_ID_CA / PUBLIC_GA_ID
PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML tag verification content value
PUBLIC_GOOGLE_SITE_VERIFICATION=

# IndexNow (Bing / Yandex) — key file lives at public/<KEY>.txt with matching body
# Repo key: e5fdb4b489461004ccd84ae7e188ac12 (auto-detected by scripts/ping-indexnow.mjs)
# Daily high-intent US guide:
#   npm run ping:indexnow:us:daily
# Or curl (same key):
#   curl -X POST https://api.indexnow.org/indexnow \
#     -H 'Content-Type: application/json; charset=utf-8' \
#     -d '{"host":"uspickleballcourt.com","key":"e5fdb4b489461004ccd84ae7e188ac12","keyLocation":"https://uspickleballcourt.com/e5fdb4b489461004ccd84ae7e188ac12.txt","urlList":["https://uspickleballcourt.com/guides/fall-league-pickleball-starter-kit"]}'
INDEXNOW_KEY=e5fdb4b489461004ccd84ae7e188ac12

# --- Specialty affiliate partners (optional until approved) ---
# Selkirk via AvantLink (apply: https://www.selkirk.com/pages/selkirk-affiliate-program)
# After approval, copy Website ID (pw) + Selkirk Merchant ID (mi) from AvantLink.
PUBLIC_AVANTLINK_WEBSITE_ID=
PUBLIC_AVANTLINK_SELKIRK_MERCHANT_ID=
# Pickleball Superstore SuperAffiliate code (enroll: https://pickleballsuperstore.com/pages/superaffiliate-enrollment)
# Example format: Jane-12345678
PUBLIC_PICKLEBALL_SUPERSTORE_CODE=
