---
import Layout from './Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Props {
	title: string;
	description: string;
	canonicalPath: string;
}

const { title, description, canonicalPath } = Astro.props;
---

<Layout title={title} description={description} canonicalPath={canonicalPath}>
	<section class="border-b border-zinc-200 bg-white">
		<div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
			<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: title }]} />
			<h1 class="text-4xl font-black tracking-tight text-zinc-900">{title}</h1>
			<p class="mt-4 text-lg text-zinc-600">{description}</p>
		</div>
	</section>
	<section class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
		<div class="max-w-[70ch] space-y-4 text-base leading-relaxed text-zinc-700 [&_a]:font-semibold [&_a]:text-emerald-800 [&_a]:underline [&_h2]:mt-8 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-zinc-900 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5">
			<slot />
		</div>
	</section>
</Layout>
