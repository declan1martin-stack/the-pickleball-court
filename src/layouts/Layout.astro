---
import '../styles/global.css';
import '../styles/news-theme.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import {
	SITE_URL,
	DEFAULT_OG_IMAGE,
	clampMetaDescription,
	formatPageTitle,
	hreflangAlternates,
	normalizePath,
	organizationSchema,
	websiteSchema,
} from '../lib/seo';
import { MARKET_LABEL, MARKET_PLAYERS, OG_LOCALE, SITE_NAME, site } from '../lib/site';

interface Props {
	title: string;
	description?: string;
	canonicalPath?: string;
	ogImage?: string;
	ogType?: 'website' | 'article';
	publishDate?: Date | string;
	updatedDate?: Date | string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	/** When true, emit noindex (e.g. soft utility pages). Default indexable. */
	noindex?: boolean;
	/**
	 * When false, skip reciprocal hreflang (market-only news that 404s on the other host).
	 * Default true for shared paths that exist on both CA and US.
	 */
	hreflang?: boolean;
}

const {
	title,
	description = `The definitive hub for ${MARKET_LABEL} pickleball court directories, premium gear reviews, and performance equipment guides for ${MARKET_PLAYERS}.`,
	canonicalPath = Astro.url.pathname,
	ogImage = DEFAULT_OG_IMAGE,
	ogType = 'website',
	publishDate,
	updatedDate,
	jsonLd = [],
	noindex = false,
	hreflang = true,
} = Astro.props;

const normalizedPath = normalizePath(canonicalPath);
const canonicalUrl =
	normalizedPath === '/'
		? SITE_URL.replace(/\/$/, '')
		: new URL(normalizedPath, SITE_URL).href;
const pageTitle = formatPageTitle(title);
const metaDescription = clampMetaDescription(description);
const imageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, SITE_URL).href;

const org = organizationSchema();
const web = websiteSchema();
const pageSchemas = (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).filter(Boolean);

/** Single @graph so Organization / WebSite / page entities share stable @ids. */
const graph = {
	'@context': 'https://schema.org',
	'@graph': [
		org,
		web,
		...pageSchemas.map((schema) => {
			const { '@context': _ctx, ...rest } = schema as Record<string, unknown>;
			return rest;
		}),
	],
};
---

<!doctype html>
<html lang={site.inLanguage} class="scroll-smooth" data-site={site.region}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={canonicalUrl} />
		{hreflang &&
			hreflangAlternates(normalizedPath).map(({ hreflang: lang, href }) => (
				<link rel="alternate" hreflang={lang} href={href} />
			))}
		<link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} Guides`} href="/rss.xml" />
		<link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} News`} href="/news/feed.xml" />
		<meta property="og:locale:alternate" content={site.region === 'us' ? 'en_CA' : 'en_US'} />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={metaDescription} />
		<meta
			name="robots"
			content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'}
		/>
		<meta name="theme-color" content="#047857" />

		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content={OG_LOCALE} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		{ogType === 'article' && publishDate && (
			<meta property="article:published_time" content={new Date(publishDate).toISOString()} />
		)}
		{ogType === 'article' && updatedDate && (
			<meta property="article:modified_time" content={new Date(updatedDate).toISOString()} />
		)}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={imageUrl} />

		<script type="application/ld+json" set:html={JSON.stringify(graph)} />

		<Analytics />
	</head>
	<body class="min-h-screen flex flex-col bg-bg text-ink antialiased">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60] focus:rounded-[var(--radius-md)] focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
		>
			Skip to content
		</a>

		<Nav />

		<main id="main-content" class="flex-grow">
			<slot />
		</main>

		<Footer />
	</body>
</html>
