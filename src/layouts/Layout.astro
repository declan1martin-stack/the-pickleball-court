---
import '../styles/global.css';
import {
	SITE_URL,
	DEFAULT_OG_IMAGE,
	clampMetaDescription,
	formatPageTitle,
	organizationSchema,
} from '../lib/seo';

interface Props {
	title: string;
	description?: string;
	canonicalPath?: string;
	ogImage?: string;
	ogType?: 'website' | 'article';
	publishDate?: Date | string;
	updatedDate?: Date | string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title,
	description = 'The definitive hub for Canadian pickleball court directories, premium gear reviews, and performance equipment guides.',
	canonicalPath = Astro.url.pathname,
	ogImage = DEFAULT_OG_IMAGE,
	ogType = 'website',
	publishDate,
	updatedDate,
	jsonLd = [],
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, SITE_URL).href;
const pageTitle = formatPageTitle(title);
const metaDescription = clampMetaDescription(description);
const imageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, SITE_URL).href;

const schemas = [
	organizationSchema(),
	...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]),
];
---

<!doctype html>
<html lang="en-CA" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" type="application/rss+xml" title="ThePickleballCourt.ca Guides" href="/rss.xml" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={metaDescription} />
		<meta name="robots" content="index,follow,max-image-preview:large" />
		<meta name="theme-color" content="#047857" />

		<meta property="og:site_name" content="ThePickleballCourt.ca" />
		<meta property="og:locale" content="en_CA" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		{ogType === 'article' && publishDate && (
			<meta property="article:published_time" content={new Date(publishDate).toISOString()} />
		)}
		{ogType === 'article' && updatedDate && (
			<meta property="article:modified_time" content={new Date(updatedDate).toISOString()} />
		)}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={imageUrl} />

		{schemas.map((schema) => (
			<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		))}
	</head>
	<body class="bg-zinc-50 text-zinc-900 min-h-screen flex flex-col antialiased">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:bg-emerald-700 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
		>
			Skip to content
		</a>

		<header class="sticky top-0 z-50 border-b border-zinc-200/80 bg-white/90 backdrop-blur-md">
			<div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
				<a
					href="/"
					class="text-xl font-black tracking-tight text-emerald-700 transition hover:text-emerald-800"
					aria-label="ThePickleballCourt.ca home"
				>
					ThePickleballCourt<span class="text-zinc-400">.ca</span>
				</a>
				<nav class="flex items-center gap-4 text-sm font-semibold text-zinc-600 sm:gap-6" aria-label="Primary">
					<a href="/gear/paddles" class="transition hover:text-emerald-700">Paddles</a>
					<a href="/gear/shoes" class="transition hover:text-emerald-700">Footwear</a>
					<a href="/gear/nets" class="transition hover:text-emerald-700">Nets</a>
					<a href="/guides" class="transition hover:text-emerald-700">Guides</a>
				</nav>
			</div>
		</header>

		<main id="main-content" class="flex-grow">
			<slot />
		</main>

		<footer class="mt-20 border-t border-zinc-800 bg-zinc-900 py-12 text-zinc-400">
			<div class="mx-auto max-w-7xl px-4 text-center sm:px-6 sm:text-left lg:px-8">
				<div class="mb-8 flex flex-col items-center justify-between gap-6 border-b border-zinc-800 pb-8 sm:flex-row">
					<p class="text-lg font-bold text-white">ThePickleballCourt.ca</p>
					<p class="max-w-xl text-xs leading-relaxed text-zinc-500">
						Disclaimer: As an Amazon Associate, this website earns commissions from qualifying purchases made through our product links at no additional cost to the consumer.
					</p>
				</div>
				<p class="text-xs text-zinc-600">
					&copy; 2026 ThePickleballCourt.ca. All rights reserved. Built for the Canadian Pickleball Community.
				</p>
			</div>
		</footer>
	</body>
</html>
