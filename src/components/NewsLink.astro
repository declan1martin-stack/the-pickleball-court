---
import { resolveNewsLink } from '../lib/newsLink';

interface Props {
	/** Bare stem (`paddle-roundup`) or full slug (`us-roundup-…` / `/news/us-roundup-…`). */
	slug: string;
	class?: string;
}

const { slug, class: className = 'font-semibold text-primary underline' } = Astro.props;
const link = await resolveNewsLink(slug);
---

<a href={link.href} class={className}>
	<slot />
</a>
