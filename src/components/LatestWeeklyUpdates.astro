---
import { formatNewsDate, getLatestNews, newsHeroMedia, newsPath, newsTypeLabel } from '../lib/news';
import SmartImage from './SmartImage.astro';

const news = await getLatestNews(3);
---

{news.length > 0 && (
	<section class="border-b border-border bg-bg" aria-labelledby="latest-weekly-updates-heading">
		<div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
			<div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
				<div class="max-w-2xl">
					<h2
						id="latest-weekly-updates-heading"
						class="font-display text-3xl font-bold tracking-tight text-ink"
					>
						Latest weekly updates
					</h2>
					<p class="mt-2 text-ink-muted">
						Pro tours, league news, and paddle launches — dated notes for shoppers who want context before they buy.
					</p>
				</div>
				<a href="/news" class="link-brand shrink-0 text-sm">View all news →</a>
			</div>

			<ul class="grid gap-4 md:grid-cols-3">
				{news.map((entry, index) => {
					const hero = newsHeroMedia(entry);
					return (
						<li>
							<article class="flex h-full flex-col overflow-hidden rounded-[var(--radius-lg)] border border-border bg-surface shadow-[var(--shadow-sm)]">
								{hero.src && (
									<a href={newsPath(entry)} tabindex="-1" aria-hidden="true">
										<SmartImage
											src={hero.src}
											alt={hero.alt}
											width={index === 0 ? 1200 : 640}
											height={index === 0 ? 675 : 360}
											loading={index === 0 ? 'eager' : 'lazy'}
											fetchpriority={index === 0 ? 'high' : undefined}
											decoding="async"
											class="aspect-[16/9] w-full object-cover"
										/>
									</a>
								)}
								<div class="flex flex-1 flex-col p-4">
									<p class="font-display text-xs font-bold uppercase tracking-wider text-secondary">
										{newsTypeLabel(entry.data.type)}
										<span aria-hidden="true"> · </span>
										<time datetime={entry.data.date.toISOString()}>
											{formatNewsDate(entry.data.date, {
												year: 'numeric',
												month: 'short',
												day: 'numeric',
											})}
										</time>
									</p>
									<h3 class="mt-2">
										<a
											href={newsPath(entry)}
											class="block font-display text-lg font-bold tracking-tight text-ink hover:text-primary"
										>
											{entry.data.title}
										</a>
									</h3>
									<p class="mt-2 line-clamp-3 text-sm leading-relaxed text-ink-muted">
										{entry.data.summary}
									</p>
									<a href={newsPath(entry)} class="link-brand mt-auto inline-flex pt-3 text-sm font-semibold">
										{index === 0 ? 'Read this week’s update →' : 'Read update →'}
									</a>
								</div>
							</article>
						</li>
					);
				})}
			</ul>
		</div>
	</section>
)}
