---
import { formatNewsDate, getAllNews, newsPath } from '../lib/news';

const news = await getAllNews();
/** Enough candidates for either market after client filter (shared CA+US Pages build). */
const candidates = news.slice(0, 8);

function marketsAttr(entry: (typeof news)[number]): string {
	return (entry.data.markets ?? ['ca', 'us']).join(' ');
}
---

{candidates.length > 0 && (
	<section
		class="border-b border-border bg-bg"
		aria-labelledby="latest-weekly-updates-heading"
		data-weekly-updates
	>
		<div class="section-y mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
				<div class="max-w-2xl">
					<h2
						id="latest-weekly-updates-heading"
						class="font-display text-3xl font-bold tracking-tight text-ink"
					>
						Latest weekly updates
					</h2>
					<p class="mt-3 text-ink-muted">
						Pro tours, league news, and paddle launches — dated notes for shoppers who want context before they buy.
					</p>
				</div>
				<a href="/news" class="link-brand shrink-0 text-sm">View all news →</a>
			</div>

			<div class="grid gap-5 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]" data-weekly-grid>
				{candidates.map((entry, index) => (
					<article
						class:list={[
							'overflow-hidden rounded-[var(--radius-lg)] border border-border bg-surface shadow-[var(--shadow-sm)]',
							index === 0 ? '' : '',
						]}
						data-news-card
						data-news-markets={marketsAttr(entry)}
						data-news-type={entry.data.type}
						hidden
					>
						{entry.data.heroImage && (
							<a href={newsPath(entry)} tabindex="-1" aria-hidden="true">
								<img
									src={entry.data.heroImage}
									alt={entry.data.heroAlt ?? ''}
									width="1200"
									height="630"
									loading={index === 0 ? 'eager' : 'lazy'}
									fetchpriority={index === 0 ? 'high' : undefined}
									decoding="async"
									class="aspect-[16/9] w-full object-cover"
									data-news-img
								/>
							</a>
						)}
						<div class="p-5 sm:p-6" data-news-body>
							<p class="font-display text-xs font-bold uppercase tracking-wider text-secondary">
								{entry.data.type === 'roundup' ? 'Roundup' : 'Update'}
								<span aria-hidden="true"> · </span>
								<time datetime={entry.data.date.toISOString()}>
									{formatNewsDate(entry.data.date, {
										year: 'numeric',
										month: 'short',
										day: 'numeric',
									})}
								</time>
							</p>
							<a
								href={newsPath(entry)}
								class="mt-2 block font-display text-base font-bold text-ink hover:text-primary"
								data-news-title
							>
								{entry.data.title}
							</a>
							<p class="mt-2 line-clamp-3 text-sm leading-relaxed text-ink-muted">
								{entry.data.summary}
							</p>
							<a
								href={newsPath(entry)}
								class="link-brand mt-4 inline-flex text-sm font-semibold"
								data-news-cta
								hidden
							>
								Read this week’s update →
							</a>
						</div>
					</article>
				))}
				<div data-more-wrap hidden>
					<p class="font-display text-xs font-bold uppercase tracking-wider text-secondary">
						More weekly updates
					</p>
					<ul class="mt-3 grid gap-4" data-more-list></ul>
				</div>
			</div>
		</div>
		<script is:inline>
			(function () {
				const root = document.querySelector('[data-weekly-updates]');
				const grid = root?.querySelector('[data-weekly-grid]');
				const moreWrap = root?.querySelector('[data-more-wrap]');
				const moreList = root?.querySelector('[data-more-list]');
				if (!root || !grid || !moreWrap || !moreList) return;

				const host = window.location.hostname.replace(/^www\./, '').toLowerCase();
				const region =
					host === 'uspickleballcourt.com'
						? 'us'
						: host === 'thepickleballcourt.ca'
							? 'ca'
							: new URLSearchParams(window.location.search).get('region') === 'us'
								? 'us'
								: 'ca';

				const cards = [...root.querySelectorAll('[data-news-card]')].filter((el) => {
					const markets = (el.getAttribute('data-news-markets') || 'ca us').split(/\s+/);
					return markets.includes(region);
				});

				// Prefer a roundup as the lead when available.
				cards.sort((a, b) => {
					const ar = a.getAttribute('data-news-type') === 'roundup' ? 0 : 1;
					const br = b.getAttribute('data-news-type') === 'roundup' ? 0 : 1;
					return ar - br;
				});

				const [lead, ...rest] = cards;
				if (!lead) {
					root.hidden = true;
					return;
				}

				lead.hidden = false;
				lead.classList.add('lg:row-span-1');
				const title = lead.querySelector('[data-news-title]');
				const body = lead.querySelector('[data-news-body]');
				const cta = lead.querySelector('[data-news-cta]');
				if (title) {
					title.className =
						'mt-3 block font-display text-2xl font-extrabold tracking-tight text-ink hover:text-primary sm:text-3xl';
				}
				if (body) body.className = 'p-6 sm:p-8';
				if (cta) cta.hidden = false;
				grid.prepend(lead);

				const more = rest.slice(0, 2);
				if (more.length) {
					moreWrap.hidden = false;
					more.forEach((card) => {
						card.hidden = false;
						const li = document.createElement('li');
						li.appendChild(card);
						moreList.appendChild(li);
					});
					grid.appendChild(moreWrap);
				}

				// Remove unused candidates from the DOM.
				root.querySelectorAll('[data-news-card][hidden]').forEach((el) => el.remove());
			})();
		</script>
	</section>
)}
