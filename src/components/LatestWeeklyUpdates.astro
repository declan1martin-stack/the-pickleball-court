---
import { formatNewsDate, getLatestNews, newsHeroMedia, newsPath, newsTypeLabel } from '../lib/news';
import SmartImage from './SmartImage.astro';

const news = await getLatestNews(3);
const lead = news[0];
const more = news.slice(1);
const leadHero = lead ? newsHeroMedia(lead) : null;
---

{lead && (
	<section class="border-b border-border bg-bg" aria-labelledby="latest-weekly-updates-heading">
		<div class="section-y mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
				<div class="max-w-2xl">
					<h2
						id="latest-weekly-updates-heading"
						class="font-display text-3xl font-bold tracking-tight text-ink"
					>
						Latest weekly updates
					</h2>
					<p class="mt-3 text-ink-muted">
						Pro tours, league news, and paddle launches — dated notes for shoppers who want context before they buy.
					</p>
				</div>
				<a href="/news" class="link-brand shrink-0 text-sm">View all news →</a>
			</div>

			<div class="grid gap-5 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
				<article class="overflow-hidden rounded-[var(--radius-lg)] border border-border bg-surface shadow-[var(--shadow-sm)]">
					{leadHero?.src && (
						<a href={newsPath(lead)} tabindex="-1" aria-hidden="true">
							<SmartImage
								src={leadHero.src}
								alt={leadHero.alt}
								width={1200}
								height={630}
								loading="eager"
								fetchpriority="high"
								decoding="async"
								class="aspect-[16/9] w-full object-cover"
							/>
						</a>
					)}
					<div class="p-6 sm:p-8">
						<p class="font-display text-xs font-bold uppercase tracking-wider text-secondary">
							{newsTypeLabel(lead.data.type)}
							<span aria-hidden="true"> · </span>
							<time datetime={lead.data.date.toISOString()}>
								{formatNewsDate(lead.data.date, {
									year: 'numeric',
									month: 'short',
									day: 'numeric',
								})}
							</time>
						</p>
						<h3 class="mt-3">
							<a
								href={newsPath(lead)}
								class="block font-display text-2xl font-extrabold tracking-tight text-ink hover:text-primary sm:text-3xl"
							>
								{lead.data.title}
							</a>
						</h3>
						<p class="mt-3 text-base leading-relaxed text-ink-muted">{lead.data.summary}</p>
						<a href={newsPath(lead)} class="link-brand mt-5 inline-flex text-sm font-semibold">
							Read this week’s update →
						</a>
					</div>
				</article>

				{more.length > 0 && (
					<div>
						<p class="font-display text-xs font-bold uppercase tracking-wider text-secondary">
							More weekly updates
						</p>
						<ul class="mt-3 grid gap-4">
							{more.map((entry) => {
								const hero = newsHeroMedia(entry);
								return (
								<li class="overflow-hidden rounded-[var(--radius-lg)] border border-border bg-surface shadow-[var(--shadow-sm)]">
									{hero.src && (
										<a href={newsPath(entry)} tabindex="-1" aria-hidden="true">
											<SmartImage
												src={hero.src}
												alt={hero.alt}
												width={640}
												height={360}
												loading="lazy"
												decoding="async"
												class="aspect-[16/9] w-full object-cover"
											/>
										</a>
									)}
									<div class="p-5">
										<p class="font-display text-xs font-bold uppercase tracking-wider text-secondary">
											{newsTypeLabel(entry.data.type)}
											<span aria-hidden="true"> · </span>
											<time datetime={entry.data.date.toISOString()}>
												{formatNewsDate(entry.data.date, {
													year: 'numeric',
													month: 'short',
													day: 'numeric',
												})}
											</time>
										</p>
										<h3 class="mt-2">
											<a
												href={newsPath(entry)}
												class="block font-display text-base font-bold text-ink hover:text-primary"
											>
												{entry.data.title}
											</a>
										</h3>
										<p class="mt-2 line-clamp-3 text-sm leading-relaxed text-ink-muted">
											{entry.data.summary}
										</p>
									</div>
								</li>
								);
							})}
						</ul>
					</div>
				)}
			</div>
		</div>
	</section>
)}
