---
/**
 * @deprecated Prefer AuthorBox with a resolved Author record.
 * Kept as a thin wrapper for any remaining call sites.
 */
import AuthorBox from './AuthorBox.astro';
import { DEFAULT_AUTHOR_ID, resolveAuthor } from '../data/authors';

interface Props {
	/** Author id from src/data/authors.json (preferred). */
	authorId?: string;
	/** @deprecated Legacy display-name prop — resolved via authors.json when possible. */
	name?: string;
}

const { authorId = DEFAULT_AUTHOR_ID, name } = Astro.props;
const author = resolveAuthor(authorId || name || DEFAULT_AUTHOR_ID);
---

<AuthorBox author={author} />
