---
import { MARKET_LABEL, SITE_NAME } from '../lib/site';

interface Props {
	name?: string;
	bio?: string;
	credential?: string;
}

const {
	name = `${SITE_NAME} Editorial Team`,
	bio = `We research pickleball paddles, court shoes, and portable nets for ${MARKET_LABEL} players — from first-time buyers to tournament regulars. Our guides prioritize court feel, fit, and practical buying advice over hype. See /about for how we research.`,
	credential = 'Editorial byline · Amazon Associates publishers',
} = Astro.props;

const initials = name
	.split(/\s+/)
	.slice(0, 2)
	.map((part) => part[0])
	.join('')
	.toUpperCase();
---

<section
	class="my-10 flex flex-col gap-4 rounded-[var(--radius-lg)] border border-border bg-surface p-5 shadow-[var(--shadow-sm)] sm:flex-row sm:items-start"
	aria-labelledby="author-heading"
>
	<div
		class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-primary font-display text-lg font-extrabold text-white"
		aria-hidden="true"
	>
		{initials}
	</div>
	<div>
		<h2 id="author-heading" class="font-display text-lg font-bold text-ink">{name}</h2>
		<p class="mt-1 text-xs font-semibold uppercase tracking-wide text-secondary">{credential}</p>
		<p class="mt-2 text-sm leading-relaxed text-ink-muted">{bio}</p>
	</div>
</section>
