---
import { formatNewsDate, newsHeroMedia, newsPath, newsTypeLabel, type NewsEntry } from '../lib/news';
import SmartImage from './SmartImage.astro';

interface Props {
	entries: NewsEntry[];
	heading?: string;
}

const { entries, heading = 'More updates' } = Astro.props;
const items = entries.slice(0, 3);
---

{items.length > 0 && (
	<section class="my-10" aria-labelledby="related-news-heading">
		<div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
			<h2 id="related-news-heading" class="font-display text-2xl font-bold tracking-tight text-ink">
				{heading}
			</h2>
			<a href="/news" class="link-brand text-sm">All news →</a>
		</div>
		<ul class="grid gap-4 md:grid-cols-3">
			{items.map((entry) => {
				const hero = newsHeroMedia(entry);
				return (
				<li class="overflow-hidden rounded-[var(--radius-lg)] border border-border bg-surface shadow-[var(--shadow-sm)]">
					{hero.src && (
						<a href={newsPath(entry)} tabindex="-1" aria-hidden="true">
							<SmartImage
								src={hero.src}
								alt={hero.alt}
								width={640}
								height={360}
								loading="lazy"
								decoding="async"
								class="aspect-[16/9] w-full object-cover"
							/>
						</a>
					)}
					<div class="p-5">
						<p class="font-display text-xs font-bold uppercase tracking-wider text-secondary">
							{newsTypeLabel(entry.data.type)}
							<span aria-hidden="true"> · </span>
							<time datetime={entry.data.date.toISOString()}>
								{formatNewsDate(entry.data.date, {
									year: 'numeric',
									month: 'short',
									day: 'numeric',
								})}
							</time>
						</p>
						<a
							href={newsPath(entry)}
							class="mt-2 block font-display text-base font-bold text-ink hover:text-primary"
						>
							{entry.data.title}
						</a>
						<p class="mt-2 line-clamp-3 text-sm leading-relaxed text-ink-muted">{entry.data.summary}</p>
					</div>
				</li>
				);
			})}
		</ul>
	</section>
)}
