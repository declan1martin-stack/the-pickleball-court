---
import { AMAZON_STORE, MARKET_COUNTRY, MARKET_PLAYERS, SITE_REGION } from '../lib/site';

interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
const other =
	SITE_REGION === 'ca'
		? { label: 'US shoppers', href: '/go/us', site: 'the US site' }
		: { label: 'Canadian shoppers', href: '/go/ca', site: 'the Canada site' };
---

<aside
	class:list={[
		'max-w-[70ch] rounded-2xl border border-emerald-200 bg-emerald-50/70 text-emerald-950',
		compact ? 'mt-3 px-4 py-2.5 text-xs leading-snug' : 'mt-6 px-5 py-4 text-sm leading-relaxed',
	]}
>
	{
		compact ? (
			<p>
				<strong class="font-bold">{MARKET_COUNTRY} store:</strong> Shop now buttons open{' '}
				<strong>{AMAZON_STORE}</strong>.{' '}
				<a href={`${other.href}?next=${encodeURIComponent(Astro.url.pathname)}`} class="font-semibold underline">
					{other.label} → {other.site}
				</a>
			</p>
		) : (
			<>
				<p class="text-xs font-bold uppercase tracking-[0.14em] text-emerald-800">{MARKET_COUNTRY} store</p>
				<p class="mt-2">
					This page is written for {MARKET_PLAYERS}. Every Shop now button opens{' '}
					<strong>{AMAZON_STORE}</strong> with our Associates tag — not the other marketplace.
				</p>
				<p class="mt-2">
					{other.label} should use{' '}
					<a
						href={`${other.href}?next=${encodeURIComponent(Astro.url.pathname)}`}
						class="font-semibold underline"
					>
						{other.site}
					</a>{' '}
					so they land on the right catalog and checkout.
				</p>
			</>
		)
	}
</aside>
