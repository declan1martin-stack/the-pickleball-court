---
interface Props {
	type?: 'tip' | 'warning' | 'pick';
	title?: string;
}

const { type = 'tip', title } = Astro.props;

const styles = {
	tip: {
		wrap: 'border-primary/20 bg-primary/5 text-ink',
		label: 'Tip',
		defaultTitle: 'Good to know',
		badge: 'bg-primary text-white',
	},
	warning: {
		wrap: 'border-accent/30 bg-accent/5 text-ink',
		label: 'Warning',
		defaultTitle: 'Watch out',
		badge: 'bg-accent text-white',
	},
	pick: {
		wrap: 'border-transparent bg-primary-dark text-white',
		label: 'Our Pick',
		defaultTitle: 'Editor’s pick',
		badge: 'bg-accent text-white',
	},
} as const;

const style = styles[type];
const heading = title ?? style.defaultTitle;
---

<aside
	class:list={['my-6 rounded-[var(--radius-lg)] border px-4 py-4 sm:px-5', style.wrap]}
	aria-label={style.label}
>
	<span class:list={['inline-flex rounded-[var(--radius-pill)] px-2.5 py-0.5 text-xs font-bold uppercase tracking-wider', style.badge]}>
		{style.label}
	</span>
	<p class:list={['font-display mt-2 text-base font-bold', type === 'pick' ? 'text-white' : 'text-ink']}>
		{heading}
	</p>
	<div
		class:list={[
			'mt-2 text-sm leading-relaxed [&_a]:font-semibold [&_a]:underline [&_p+p]:mt-2',
			type === 'pick' ? 'text-white/90 [&_a]:text-accent' : 'text-ink-muted [&_a]:text-primary',
		]}
	>
		<slot />
	</div>
</aside>
