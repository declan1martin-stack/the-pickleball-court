---
import { Picture } from 'astro:assets';

interface Props {
	src: string;
	alt: string;
	width: number;
	height: number;
	loading?: 'lazy' | 'eager';
	fetchpriority?: 'high' | 'low' | 'auto';
	decoding?: 'async' | 'auto' | 'sync';
	class?: string;
}

const {
	src,
	alt,
	width,
	height,
	loading = 'lazy',
	fetchpriority,
	decoding = 'async',
	class: className,
} = Astro.props;

const remote = /^https?:\/\//i.test(src);
const eager = loading === 'eager' || fetchpriority === 'high';
const imgLoading = eager ? 'eager' : 'lazy';
const imgPriority = fetchpriority === 'high' ? 'high' : undefined;

/**
 * Do not mirror `class` onto <picture>. Duplicating margin/aspect-ratio onto both
 * <picture> and <img> caused cold-load CLS (~0.09) on guide heroes: the two
 * mt-8 values collapsed inconsistently as the image sized, shifting the page.
 * Layout classes stay on the <img> (or an outer wrapper); <picture> is only a
 * block wrapper.
 */
---

{
	remote ? (
		<Picture
			src={src}
			alt={alt}
			width={width}
			height={height}
			formats={['avif', 'webp']}
			fallbackFormat="jpg"
			loading={imgLoading}
			fetchpriority={imgPriority}
			decoding={decoding}
			class={className}
			pictureAttributes={{ class: 'block h-full w-full max-w-full' }}
		/>
	) : (
		<img
			src={src}
			alt={alt}
			width={width}
			height={height}
			loading={imgLoading}
			fetchpriority={imgPriority}
			decoding={decoding}
			class={className}
		/>
	)
}
