---
interface Props {
	headers: string[];
	rows: string[][];
	caption?: string;
}

const { headers, rows, caption = 'Comparison' } = Astro.props;
const titleIndex = 0;
---

{
	rows.length > 0 && headers.length > 0 && (
		<section class="my-8 max-w-full" aria-label={caption}>
			{/* Desktop / tablet table */}
			<div class="hidden max-w-full overflow-x-auto rounded-[var(--radius-lg)] border border-border lg:block">
				<table class="min-w-full divide-y divide-border text-left text-sm">
					<caption class="sr-only">{caption}</caption>
					<thead class="bg-primary-dark text-white">
						<tr>
							{headers.map((header) => (
								<th scope="col" class="px-4 py-3 font-semibold whitespace-nowrap">
									{header}
								</th>
							))}
						</tr>
					</thead>
					<tbody class="divide-y divide-border bg-surface">
						{rows.map((row) => (
							<tr>
								{headers.map((_, index) =>
									index === titleIndex ? (
										<th
											scope="row"
											class="sticky left-0 bg-surface px-4 py-4 font-bold text-ink shadow-[1px_0_0_var(--color-border)]"
										>
											{row[index] ?? '—'}
										</th>
									) : (
										<td class="px-4 py-4 leading-relaxed text-ink-muted">{row[index] ?? '—'}</td>
									),
								)}
							</tr>
						))}
					</tbody>
				</table>
			</div>

			{/* Mobile / tablet stacked cards — one card per row, labels above values */}
			<ul class="grid list-none gap-4 p-0 lg:hidden">
				{rows.map((row) => (
					<li class="rounded-2xl border border-border bg-surface p-4 shadow-[var(--shadow-sm)]">
						<p class="font-display text-base font-bold text-ink">{row[titleIndex] ?? '—'}</p>
						<dl class="mt-3 space-y-3">
							{headers.map((header, index) =>
								index === titleIndex ? null : (
									<div>
										<dt class="text-xs font-bold uppercase tracking-[0.12em] text-ink-muted">
											{header}
										</dt>
										<dd class="mt-1 text-sm leading-relaxed text-ink">{row[index] ?? '—'}</dd>
									</div>
								),
							)}
						</dl>
					</li>
				))}
			</ul>
		</section>
	)
}
