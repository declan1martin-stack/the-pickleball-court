---
import { PARTNER_LABELS } from '../lib/partners';
import { AMAZON_LABEL, SITE_NAME } from '../lib/site';

interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<aside
	class:list={[
		'rounded-[var(--radius-md)] border border-border bg-bg text-ink',
		compact ? 'px-3 py-2 text-xs' : 'px-4 py-3 text-sm',
	]}
	aria-label="Affiliate disclosure"
>
	<p class:list={[compact ? 'leading-snug' : 'leading-relaxed', 'font-medium text-ink']}>
		As an Amazon Associate I earn from qualifying purchases.
	</p>
	<p class:list={[compact ? 'mt-1.5 leading-snug' : 'mt-2 leading-relaxed', 'text-ink-muted']}>
		<strong class="font-bold text-ink">Disclosure:</strong>
		{SITE_NAME} uses affiliate links for {AMAZON_LABEL}, {PARTNER_LABELS.selkirk}, and{' '}
		{PARTNER_LABELS.pickleballSuperstore}. We may earn a commission from qualifying purchases at no extra cost to
		you. Always confirm the current price and availability on the retailer you choose.
	</p>
</aside>
