---
import { AMAZON_LABEL, SITE_NAME } from '../lib/site';

interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<aside
	class:list={[
		'rounded-[var(--radius-md)] border border-border bg-bg text-ink',
		compact ? 'px-3 py-2 text-xs' : 'px-4 py-3 text-sm',
	]}
	aria-label="Affiliate disclosure"
>
	<p class:list={[compact ? 'leading-snug' : 'leading-relaxed', 'text-ink-muted']}>
		<strong class="font-bold text-ink">Disclosure:</strong>
		{SITE_NAME} is a participant in the Amazon Services LLC Associates Program.
		As an Amazon Associate we earn from qualifying purchases. Links may be affiliate links —
		they do not change your price. Always confirm the current price and availability on {AMAZON_LABEL}.
	</p>
</aside>
