---
import { PARTNER_LABELS } from '../lib/partners';
import { AMAZON_STORE, SITE_NAME, SITE_REGION } from '../lib/site';

interface Props {
	compact?: boolean;
	/** When true, skip the verbatim Associates sentence (e.g. already shown above on /affiliate-disclosure). */
	omitAmazonSentence?: boolean;
}

const { compact = false, omitAmazonSentence = false } = Astro.props;
---

<aside
	class:list={[
		'rounded-[var(--radius-md)] border border-border bg-bg text-ink',
		compact ? 'px-3 py-2 text-xs' : 'px-4 py-3 text-sm',
	]}
	aria-label="Affiliate disclosure"
>
	{!omitAmazonSentence && (
		<p class:list={[compact ? 'leading-snug' : 'leading-relaxed', 'font-medium text-ink']}>
			As an Amazon Associate I earn from qualifying purchases.
		</p>
	)}
	<p
		class:list={[
			compact ? 'leading-snug' : 'leading-relaxed',
			'text-ink-muted',
			!omitAmazonSentence && (compact ? 'mt-1.5' : 'mt-2'),
		]}
	>
		<strong class="font-bold text-ink">Disclosure:</strong>
		{SITE_NAME} uses affiliate links for {AMAZON_STORE}
		{SITE_REGION === 'ca'
			? `, ${PARTNER_LABELS.selkirk}, and ${PARTNER_LABELS.pickleballSuperstore}`
			: ` and ${PARTNER_LABELS.selkirk}`}
		. We may earn a commission from qualifying purchases at no extra cost to you. Always confirm the current price
		and availability on the retailer you choose.
	</p>
</aside>
