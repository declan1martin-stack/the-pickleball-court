---
import { MARKET_LABEL, SITE_EMAIL, SITE_NAME } from '../lib/site';
import { getLatestGearPost, newsPath } from '../lib/news';

const footerLogo = '/brand/pc-logo-us-white.svg';
const footerAlt = 'US Pickleball Court';
const latestGear = await getLatestGearPost();
const latestGearHref = latestGear ? newsPath(latestGear) : '/news';
---

<footer class="mt-10 max-w-full min-w-0 overflow-x-clip bg-footer py-10 text-footer-text">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-10 border-b border-white/10 pb-10 md:grid-cols-2 lg:grid-cols-4">
			<div>
				<a href="/" class="inline-block">
					<img
						src={footerLogo}
						width="180"
						height="51"
						alt={footerAlt}
						decoding="async"
					/>
				</a>
				<p class="mt-3 max-w-xs text-sm leading-relaxed text-footer-text/80">
					Knowledgeable, honest gear guides for {MARKET_LABEL} pickleball — paddles, shoes, balls, bags, apparel, and nets.
				</p>
				<p class="mt-3 text-sm">
					<a href={`mailto:${SITE_EMAIL}`} class="footer-link footer-link--inline">{SITE_EMAIL}</a>
				</p>
			</div>
			<div>
				<p class="font-display text-sm font-bold text-white">Shop</p>
				<ul class="mt-3 space-y-0 text-sm">
					<li><a href="/gear" class="footer-link">Gear</a></li>
					<li><a href="/gear/paddles" class="footer-link">Paddles</a></li>
					<li><a href="/gear/shoes" class="footer-link">Shoes</a></li>
					<li><a href="/gear/balls" class="footer-link">Balls</a></li>
					<li><a href="/gear/bags" class="footer-link">Bags</a></li>
					<li><a href="/gear/nets" class="footer-link">Nets</a></li>
					<li><a href="/gear/apparel" class="footer-link">Apparel</a></li>
					<li><a href="/gear/accessories" class="footer-link">Accessories</a></li>
					<li><a href="/gear/training" class="footer-link">Training</a></li>
					<li><a href="/guides/best-pickleball-paddles-2026" class="footer-link">Best Picks</a></li>
				</ul>
			</div>
			<div>
				<p class="font-display text-sm font-bold text-white">Learn</p>
				<ul class="mt-3 space-y-0 text-sm">
					<li><a href="/guides" class="footer-link">Guides</a></li>
					<li><a href="/news" class="footer-link">News & weekly updates</a></li>
					<li><a href={latestGearHref} class="footer-link">Latest gear roundup</a></li>
					<li><a href="/guides/how-to-choose-a-pickleball-paddle" class="footer-link">Choose a paddle</a></li>
					<li><a href="/guides/pickleball-rules-for-beginners" class="footer-link">Rules for beginners</a></li>
					<li><a href="/about" class="footer-link">About / How we test</a></li>
					<li><a href="/editorial-policy" class="footer-link">Editorial policy</a></li>
				</ul>
			</div>
			<div>
				<p class="font-display text-sm font-bold text-white">Legal</p>
				<ul class="mt-3 space-y-0 text-sm">
					<li><a href="/affiliate-disclosure" class="footer-link">Affiliate disclosure</a></li>
					<li><a href="/privacy" class="footer-link">Privacy</a></li>
					<li><a href="/terms" class="footer-link">Terms</a></li>
					<li><a href="/contact" class="footer-link">Contact</a></li>
				</ul>
			</div>
		</div>
		<p class="pt-8 text-xs leading-relaxed text-footer-text">
			As an Amazon Associate I earn from qualifying purchases.{' '}
			<a href="/affiliate-disclosure" class="footer-link footer-link--inline underline">Affiliate disclosure</a>.
		</p>
		<p class="pt-3 text-xs text-footer-text/60">
			&copy; 2026 {SITE_NAME}. All rights reserved. Built for the {MARKET_LABEL} Pickleball Community.
		</p>
	</div>
</footer>
