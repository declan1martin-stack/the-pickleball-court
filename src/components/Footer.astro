---
import { PARTNER_LABELS } from '../lib/partners';
import { AMAZON_LABEL, AMAZON_STORE, MARKET_LABEL, SITE_EMAIL, SITE_NAME, SITE_REGION } from '../lib/site';
import { getLatestGearPost, newsPath } from '../lib/news';

const footerLogo =
	SITE_REGION === 'us' ? '/brand/pc-logo-us-white.svg' : '/brand/pc-logo-ca-white.svg';
const footerAlt = SITE_REGION === 'us' ? 'US Pickleball Court' : 'The Pickleball Court';
const otherRegion = SITE_REGION === 'ca' ? 'us' : 'ca';
const otherSite = SITE_REGION === 'ca' ? 'the US site' : 'the Canada site';
const latestGear = await getLatestGearPost();
const latestGearHref = latestGear ? newsPath(latestGear) : '/news';
---

<footer class="mt-10 bg-footer py-10 text-footer-text">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-10 border-b border-white/10 pb-10 md:grid-cols-2 lg:grid-cols-4">
			<div>
				<a href="/" class="inline-block">
					<img
						src={footerLogo}
						width="180"
						height="51"
						alt={footerAlt}
						decoding="async"
					/>
				</a>
				<p class="mt-3 max-w-xs text-sm leading-relaxed text-footer-text/80">
					Knowledgeable, honest gear guides for {MARKET_LABEL} pickleball — paddles, shoes, balls, bags, apparel, and nets.
				</p>
				<p class="mt-4 text-xs leading-relaxed text-footer-text/70">
					Product links on this host open {AMAZON_STORE} ({AMAZON_LABEL})
					{SITE_REGION === 'ca' ? `, ${PARTNER_LABELS.selkirk}, and ${PARTNER_LABELS.pickleballSuperstore}` : ` and ${PARTNER_LABELS.selkirk}`}
					— we may earn a commission at no extra cost to you. Always confirm the current price on the retailer you choose.
				</p>
				<p class="mt-3 text-sm">
					<a href={`/go/${otherRegion}`} class="hover:text-white">
						Shop {otherSite}
					</a>
				</p>
				<p class="mt-3 text-sm">
					<a href={`mailto:${SITE_EMAIL}`} class="hover:text-white">{SITE_EMAIL}</a>
				</p>
			</div>
			<div>
				<p class="font-display text-sm font-bold text-white">Shop</p>
				<ul class="mt-3 space-y-2 text-sm">
					<li><a href="/gear/paddles" class="hover:text-white">Paddles</a></li>
					<li><a href="/gear/shoes" class="hover:text-white">Shoes</a></li>
					<li><a href="/gear/balls" class="hover:text-white">Balls</a></li>
					<li><a href="/gear/bags" class="hover:text-white">Bags</a></li>
					<li><a href="/gear/nets" class="hover:text-white">Nets</a></li>
					<li><a href="/gear/apparel" class="hover:text-white">Apparel</a></li>
					<li><a href="/gear/accessories" class="hover:text-white">Accessories</a></li>
					<li><a href="/guides/best-pickleball-paddles-2026" class="hover:text-white">Best Picks</a></li>
				</ul>
			</div>
			<div>
				<p class="font-display text-sm font-bold text-white">Learn</p>
				<ul class="mt-3 space-y-2 text-sm">
					<li><a href="/guides" class="hover:text-white">Guides</a></li>
					<li><a href="/news" class="hover:text-white">News & weekly updates</a></li>
					<li><a href={latestGearHref} class="hover:text-white">Latest gear roundup</a></li>
					<li><a href="/guides/how-to-choose-a-pickleball-paddle" class="hover:text-white">Choose a paddle</a></li>
					<li><a href="/guides/pickleball-rules-for-beginners" class="hover:text-white">Rules for beginners</a></li>
					<li><a href="/about" class="hover:text-white">About / How we test</a></li>
					<li><a href="/editorial-policy" class="hover:text-white">Editorial policy</a></li>
				</ul>
			</div>
			<div>
				<p class="font-display text-sm font-bold text-white">Legal</p>
				<ul class="mt-3 space-y-2 text-sm">
					<li><a href="/affiliate-disclosure" class="hover:text-white">Affiliate disclosure</a></li>
					<li><a href="/privacy" class="hover:text-white">Privacy</a></li>
					<li><a href="/terms" class="hover:text-white">Terms</a></li>
					<li><a href="/contact" class="hover:text-white">Contact</a></li>
				</ul>
			</div>
		</div>
		<p class="pt-8 text-xs text-footer-text/60">
			&copy; 2026 {SITE_NAME}. All rights reserved. Built for the {MARKET_LABEL} Pickleball Community.
		</p>
	</div>
</footer>
