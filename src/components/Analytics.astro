---
/**
 * GA4 + Google Search Console verification.
 *
 * CA: G-JWSBZJ6R4P (thepickleballcourt.ca).
 * US: G-WE9TTJLH00 (uspickleballcourt.com). Never falls back to the CA property.
 * Optional override: PUBLIC_GA_MEASUREMENT_ID / PUBLIC_GA_ID /
 * PUBLIC_GA_MEASUREMENT_ID_US (must not be the other region's ID).
 *
 *   PUBLIC_GOOGLE_SITE_VERIFICATION=token_from_search_console
 *
 * Runtime `site_region` (ca|us) is attached to page views and events.
 */
import { resolveGaMeasurementId } from '../lib/analytics';

const gaId = resolveGaMeasurementId();
const gsc = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
---

{gsc && <meta name="google-site-verification" content={gsc} />}

{gaId && (
	<>
		<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
		<script is:inline define:vars={{ gaId }}>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			window.gtag = gtag;

			function siteRegion() {
				const host = window.location.hostname.replace(/^www\./, '').toLowerCase();
				if (host === 'uspickleballcourt.com') return 'us';
				if (host === 'thepickleballcourt.ca') return 'ca';
				const q = new URLSearchParams(window.location.search).get('region');
				return q === 'us' ? 'us' : 'ca';
			}

			const region = siteRegion();
			const hostname = window.location.hostname.replace(/^www\./, '').toLowerCase();
			gtag('js', new Date());
			gtag('set', 'user_properties', { site_region: region });
			gtag('config', gaId, {
				anonymize_ip: true,
				send_page_view: true,
				// Custom dims: register site_region + hostname in GA4 Admin → Custom definitions
				site_region: region,
				site_hostname: hostname,
			});

			document.addEventListener(
				'click',
				(event) => {
					const link = event.target?.closest?.('a[data-affiliate="retail"]');
					if (!link || typeof window.gtag !== 'function') return;
					window.gtag('event', 'affiliate_click', {
						event_category: 'affiliate',
						event_label: link.dataset.productId || link.href,
						product_id: link.dataset.productId || undefined,
						affiliate_partner: link.dataset.affiliatePartner || 'amazon',
						link_url: link.href,
						site_region: siteRegion(),
						transport_type: 'beacon',
					});
				},
				{ capture: true },
			);
		</script>
	</>
)}
