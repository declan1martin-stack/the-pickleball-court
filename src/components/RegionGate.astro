---
/**
 * First-visit geography modal + open triggers via [data-open-region-gate].
 * Current region is detected from hostname at runtime (shared Pages build).
 */
---

<div
	id="region-gate"
	class="fixed inset-0 z-[80] hidden items-end justify-center bg-ink/45 p-4 sm:items-center"
	role="dialog"
	aria-modal="true"
	aria-labelledby="region-gate-title"
	aria-describedby="region-gate-desc"
	hidden
>
	<div
		class="w-full max-w-md rounded-[var(--radius-lg)] border border-border bg-surface p-6 shadow-lg sm:p-7"
		data-region-panel
	>
		<p class="font-display text-xs font-bold uppercase tracking-[0.18em] text-accent">Shop by country</p>
		<h2 id="region-gate-title" class="mt-2 font-display text-2xl font-extrabold tracking-tight text-ink">
			Where do you buy gear?
		</h2>
		<p id="region-gate-desc" class="mt-2 text-sm leading-relaxed text-ink-muted">
			We’ll send you to the right site with the correct Amazon store and product links for your country.
		</p>

		<div class="mt-6 grid gap-3">
			<a
				href="/go/ca"
				data-region-choice="ca"
				class="block rounded-[var(--radius-md)] border border-border bg-bg px-4 py-3 text-left transition hover:border-primary hover:bg-white"
			>
				<span class="block font-display text-base font-bold text-ink">Canada</span>
				<span class="mt-0.5 block text-sm text-ink-muted">Canadian store · Amazon Canada product links</span>
			</a>
			<a
				href="/go/us"
				data-region-choice="us"
				class="block rounded-[var(--radius-md)] border border-border bg-bg px-4 py-3 text-left transition hover:border-primary hover:bg-white"
			>
				<span class="block font-display text-base font-bold text-ink">United States</span>
				<span class="mt-0.5 block text-sm text-ink-muted">US store · Amazon US product links</span>
			</a>
		</div>

		<button
			type="button"
			id="region-gate-dismiss"
			class="mt-4 w-full rounded-[var(--radius-md)] px-3 py-2 text-sm font-semibold text-ink-muted transition hover:bg-bg hover:text-ink"
		>
			Stay on this site
		</button>
	</div>
</div>

<script>
	const STORAGE_KEY = 'tpc-region-choice';

	function currentRegion() {
		const host = window.location.hostname.replace(/^www\./, '').toLowerCase();
		if (host === 'uspickleballcourt.com') return 'us';
		if (host === 'thepickleballcourt.ca') return 'ca';
		const q = new URLSearchParams(window.location.search).get('region');
		return q === 'us' ? 'us' : 'ca';
	}

	function nextPath() {
		return `${window.location.pathname}${window.location.search}` || '/';
	}

	function goHref(region) {
		const path = region === 'us' ? '/go/us' : '/go/ca';
		const url = new URL(path, window.location.origin);
		url.searchParams.set('next', nextPath());
		return `${url.pathname}${url.search}`;
	}

	function saveRegion(region) {
		try {
			localStorage.setItem(STORAGE_KEY, region);
		} catch {
			/* ignore */
		}
	}

	function savedRegion() {
		try {
			return localStorage.getItem(STORAGE_KEY);
		} catch {
			return null;
		}
	}

	function trackRegion(eventName, params = {}) {
		if (typeof window.gtag !== 'function') return;
		window.gtag('event', eventName, {
			site_region: currentRegion(),
			transport_type: 'beacon',
			...params,
		});
	}

	const gate = document.getElementById('region-gate');
	const dismissBtn = document.getElementById('region-gate-dismiss');

	function openGate(source = 'auto') {
		if (!gate) return;
		gate.hidden = false;
		gate.classList.remove('hidden');
		gate.classList.add('flex');
		document.documentElement.classList.add('overflow-hidden');
		dismissBtn?.focus();
		trackRegion('region_gate_open', { gate_source: source });
	}

	function closeGate() {
		if (!gate) return;
		gate.hidden = true;
		gate.classList.add('hidden');
		gate.classList.remove('flex');
		document.documentElement.classList.remove('overflow-hidden');
	}

	document.querySelectorAll('[data-region-choice]').forEach((el) => {
		const region = el.getAttribute('data-region-choice') || 'ca';
		el.setAttribute('href', goHref(region));
		el.addEventListener('click', (event) => {
			saveRegion(region);
			trackRegion('region_choice', {
				chosen_region: region,
				from_region: currentRegion(),
				switched: region !== currentRegion(),
			});
			if (region === currentRegion()) {
				event.preventDefault();
				closeGate();
			}
		});
	});

	dismissBtn?.addEventListener('click', () => {
		saveRegion(currentRegion());
		trackRegion('region_gate_dismiss', { dismiss_method: 'button' });
		closeGate();
	});

	gate?.addEventListener('click', (event) => {
		if (event.target === gate) {
			saveRegion(currentRegion());
			trackRegion('region_gate_dismiss', { dismiss_method: 'backdrop' });
			closeGate();
		}
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && gate && !gate.hidden) {
			saveRegion(currentRegion());
			trackRegion('region_gate_dismiss', { dismiss_method: 'escape' });
			closeGate();
		}
	});

	document.querySelectorAll('[data-open-region-gate]').forEach((el) => {
		el.addEventListener('click', (event) => {
			event.preventDefault();
			openGate('manual');
		});
	});

	document.querySelectorAll('[data-region-label]').forEach((label) => {
		label.textContent = currentRegion() === 'us' ? 'United States' : 'Canada';
	});

	if (!savedRegion()) {
		openGate('auto');
	}
</script>
