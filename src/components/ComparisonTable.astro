---
import AffiliateButton from './AffiliateButton.astro';
import { getAffiliateUrl, getPriceTier, getProductsByIds, type Product } from '../lib/products';
import { AMAZON_STORE } from '../lib/site';
import { marketizeCopy } from '../lib/marketCopy';

type SpecField = 'brand' | 'category' | 'priceTier' | 'featureHighlight';

interface Props {
	productIds: string[];
	fields?: SpecField[];
	caption?: string;
}

const { productIds, fields = ['brand', 'priceTier', 'featureHighlight'], caption = 'Product comparison' } =
	Astro.props;

const products = getProductsByIds(productIds);

function cellValue(product: Product, field: SpecField): string {
	switch (field) {
		case 'brand':
			return product.brand;
		case 'category':
			return product.category;
		case 'priceTier':
			return getPriceTier(product.price);
		case 'featureHighlight':
			return marketizeCopy(product.features[0] ?? '—');
		default:
			return '—';
	}
}

const fieldLabels: Record<SpecField, string> = {
	brand: 'Brand',
	category: 'Category',
	priceTier: 'Price tier',
	featureHighlight: 'Standout trait',
};
---

{products.length > 0 && (
	<section class="my-8" aria-label={caption}>
		{/* Desktop / tablet table */}
		<div class="hidden overflow-x-auto rounded-[var(--radius-lg)] border border-border md:block">
			<table class="min-w-full divide-y divide-border text-left text-sm">
				<caption class="sr-only">{caption}</caption>
				<thead class="bg-primary-dark text-white">
					<tr>
						<th scope="col" class="px-4 py-3 font-semibold">Product</th>
						{fields.map((field) => (
							<th scope="col" class="px-4 py-3 font-semibold">
								{fieldLabels[field]}
							</th>
						))}
						<th scope="col" class="px-4 py-3 font-semibold">Store</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-border bg-surface">
					{products.map((product) => (
						<tr>
							<th scope="row" class="px-4 py-4 font-bold text-ink">
								{product.name}
							</th>
							{fields.map((field) => (
								<td class="px-4 py-4 text-ink-muted">
									{field === 'priceTier' ? (
										<span title="Approximate price tier based on catalog listing — not a live store price">
											{cellValue(product, field)}
										</span>
									) : (
										cellValue(product, field)
									)}
								</td>
							))}
							<td class="px-4 py-4">
								<AffiliateButton href={getAffiliateUrl(product)} productId={product.id} variant="secondary" />
							</td>
						</tr>
					))}
				</tbody>
			</table>
			<p class="border-t border-zinc-200 bg-zinc-50 px-4 py-2 text-xs text-zinc-500">
				Price tiers ($–$$$$$) are relative catalog bands (entry through flagship), not live store prices. Always confirm the current price on {AMAZON_STORE}.
			</p>
		</div>

		{/* Mobile stacked cards */}
		<ul class="grid gap-4 md:hidden">
			{products.map((product) => (
				<li class="rounded-2xl border border-zinc-200 bg-white p-4">
					<h3 class="text-base font-bold text-zinc-900">{product.name}</h3>
					<dl class="mt-3 space-y-2 text-sm">
						{fields.map((field) => (
							<div class="flex justify-between gap-3 border-b border-zinc-100 pb-2">
								<dt class="font-medium text-zinc-500">{fieldLabels[field]}</dt>
								<dd class="text-right font-semibold text-zinc-800">{cellValue(product, field)}</dd>
							</div>
						))}
					</dl>
					<div class="mt-4">
						<AffiliateButton href={getAffiliateUrl(product)} productId={product.id} />
					</div>
				</li>
			))}
		</ul>
	</section>
)}
