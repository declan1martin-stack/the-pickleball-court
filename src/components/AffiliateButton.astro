---
import { AMAZON_STORE } from '../lib/site';
import { assertAffiliateUrl } from '../lib/products';

interface Props {
	href: string;
	label?: string;
	variant?: 'primary' | 'secondary' | 'inline';
	class?: string;
	/** Optional product id for GA4 affiliate_click events */
	productId?: string;
	/**
	 * amazon → normalize host/tag for this region.
	 * partner → leave href as-is (Selkirk AvantLink / Pickleball Superstore / etc.).
	 */
	network?: 'amazon' | 'partner';
	/** Partner id for analytics (selkirk, pickleball-superstore, amazon). */
	partner?: string;
}

const {
	href,
	label = `Check current price on ${AMAZON_STORE}`,
	variant = 'primary',
	class: className = '',
	productId,
	network = 'amazon',
	partner = network === 'amazon' ? 'amazon' : 'partner',
} = Astro.props;

const safeHref = network === 'amazon' ? assertAffiliateUrl(href) : href;

const variants = {
	primary: 'btn-primary w-full sm:w-auto',
	secondary: 'btn-secondary w-full sm:w-auto',
	inline: 'link-brand underline underline-offset-2',
};
---

<a
	href={safeHref}
	target="_blank"
	rel="sponsored nofollow noopener"
	data-affiliate="retail"
	data-affiliate-partner={partner}
	data-product-id={productId}
	class:list={[variants[variant], className]}
>
	{label}
	{variant !== 'inline' && <span class="sr-only"> (opens in a new tab)</span>}
</a>
