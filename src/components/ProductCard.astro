---
import AffiliateButton from './AffiliateButton.astro';
import type { Product } from '../lib/products';

interface Props {
	product: Product;
}

const { product } = Astro.props;
---

<article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-md">
	<div class="relative aspect-[4/3] overflow-hidden bg-zinc-100">
		<img
			src={product.imageUrl}
			alt={`${product.brand} ${product.name}`}
			width="800"
			height="600"
			loading="lazy"
			decoding="async"
			class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
		/>
		<span class="absolute left-3 top-3 rounded-full bg-zinc-900/90 px-3 py-1 text-xs font-bold uppercase tracking-wide text-white">
			{product.brand}
		</span>
	</div>

	<div class="flex flex-1 flex-col p-5 sm:p-6">
		<p class="text-xs font-semibold uppercase tracking-wider text-emerald-700">{product.category}</p>
		<h3 class="mt-1 text-lg font-bold leading-snug text-zinc-900 sm:text-xl">{product.name}</h3>
		<p class="mt-2 text-2xl font-black tracking-tight text-zinc-900">{product.price}</p>
		<p class="mt-1 text-xs text-zinc-500">Approximate listed price — confirm current price on Amazon.ca</p>
		<p class="mt-3 line-clamp-3 text-sm leading-relaxed text-zinc-600">{product.description}</p>

		<ul class="mt-4 space-y-2 text-sm text-zinc-700">
			{product.features.map((feature) => (
				<li class="flex gap-2">
					<span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-600" aria-hidden="true" />
					<span>{feature}</span>
				</li>
			))}
		</ul>

		<div class="mt-auto pt-6">
			<AffiliateButton href={product.affiliateUrl} class="w-full sm:w-full" />
		</div>
	</div>
</article>
