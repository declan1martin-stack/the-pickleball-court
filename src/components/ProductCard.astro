---
import AffiliateButton from './AffiliateButton.astro';
import StarRating from './StarRating.astro';
import SmartImage from './SmartImage.astro';
import {
	getAffiliateUrl,
	getComfortTags,
	getEffectiveGender,
	getPriceTier,
	getShopCtaLabel,
	type Product,
} from '../lib/products';
import { getPartnerOffers } from '../lib/partners';
import { absoluteUrl, productSchema } from '../lib/seo';
import { AMAZON_STORE } from '../lib/site';
import { DEFAULT_AUTHOR_ID, getAuthor } from '../data/authors';
import { marketizeCopy } from '../lib/marketCopy';
import Schema from './Schema.astro';

interface Props {
	product: Product;
	/** Only pass a real rating from data — never invent one. */
	rating?: number | null;
	/** First-in-viewport card (category LCP). */
	priority?: boolean;
}

const { product, rating = null, priority = false } = Astro.props;
const tier = getPriceTier(product.price);
const affiliateHref = getAffiliateUrl(product);
const description = marketizeCopy(product.description);
const features = product.features.map((feature) => marketizeCopy(feature));
const imageAbs = product.imageUrl.startsWith('http')
	? product.imageUrl
	: absoluteUrl(product.imageUrl);
/** On-site product URL for schema — never the affiliate tracking URL. */
const onSiteUrl = absoluteUrl(`/gear/${product.category}#${product.id}`);
const author = getAuthor(DEFAULT_AUTHOR_ID);
const schema = productSchema({
	name: product.name,
	description,
	image: imageAbs,
	brand: product.brand,
	url: onSiteUrl,
	review: author
		? {
				author: author.name,
				reviewBody: description,
				datePublished: '2026-01-01',
				...(typeof rating === 'number' ? { ratingValue: rating } : {}),
			}
		: undefined,
});
const gender = getEffectiveGender(product);
const comfortTags = getComfortTags(product);
const partnerOffers = getPartnerOffers(product);
const imageAlt = product.name.toLowerCase().startsWith(product.brand.toLowerCase())
	? product.name
	: `${product.brand} ${product.name}`;
---

<article
	id={product.id}
	data-product-card
	data-gender={gender}
	data-comfort={comfortTags.join(' ')}
	class="group flex h-full flex-col overflow-hidden rounded-[var(--radius-lg)] border border-border bg-surface shadow-[var(--shadow-sm)] transition hover:-translate-y-0.5 hover:shadow-[var(--shadow-md)]"
>
	<Schema data={schema} />
	<div class="relative aspect-[4/3] overflow-hidden bg-border/40">
		<SmartImage
			src={product.imageUrl}
			alt={imageAlt}
			width={800}
			height={600}
			loading={priority ? 'eager' : 'lazy'}
			fetchpriority={priority ? 'high' : undefined}
			decoding="async"
			class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
		/>
	</div>

	<div class="flex flex-1 flex-col p-5 sm:p-6">
		<p class="font-display text-xs font-bold uppercase tracking-[0.14em] text-secondary">{product.brand}</p>
		<h3 class="font-display mt-2 text-lg font-bold leading-snug text-ink sm:text-xl">{product.name}</h3>
		<div class="mt-2 flex items-center gap-3">
			<StarRating rating={rating} />
			<span
				class="rounded-[var(--radius-pill)] bg-bg px-2.5 py-0.5 font-mono text-sm font-semibold text-primary"
				title="Approximate catalog price tier — not a live store price"
			>
				{tier}
			</span>
		</div>
		<p class="mt-2 text-xs text-ink-faint">
			Approximate price tier — confirm current price on {AMAZON_STORE}
		</p>
		<p class="mt-3 line-clamp-3 text-sm leading-relaxed text-ink-muted">{description}</p>

		<ul class="mt-4 space-y-2 text-sm text-ink">
			{features.map((feature) => (
				<li class="flex gap-2">
					<span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-secondary" aria-hidden="true" />
					<span>{feature}</span>
				</li>
			))}
		</ul>

		<div class="mt-auto flex flex-col gap-2 pt-6">
			<AffiliateButton
				href={affiliateHref}
				label={getShopCtaLabel(product, AMAZON_STORE)}
				productId={product.id}
				partner="amazon"
				class="w-full sm:w-full"
			/>
			{partnerOffers.map((offer) => (
				<AffiliateButton
					href={offer.href}
					label={offer.label}
					variant="secondary"
					network="partner"
					partner={offer.id}
					productId={product.id}
					class="w-full sm:w-full"
				/>
			))}
		</div>
	</div>
</article>
