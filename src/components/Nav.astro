---
const links = [
	{ href: '/gear/paddles', label: 'Paddles' },
	{ href: '/gear/shoes', label: 'Shoes' },
	{ href: '/gear/balls', label: 'Balls' },
	{ href: '/gear/bags', label: 'Bags' },
	{ href: '/gear/nets', label: 'Nets' },
	{ href: '/gear/accessories', label: 'Accessories' },
	{ href: '/guides', label: 'Guides' },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-surface/95 backdrop-blur-md">
	<div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
		<a href="/" class="font-display text-lg font-extrabold tracking-tight text-primary sm:text-xl" aria-label="The Pickleball Court home">
			The Pickleball Court<span class="text-ink-faint">.ca</span>
		</a>

		<nav class="hidden items-center gap-6 text-sm font-semibold text-ink-muted lg:flex" aria-label="Primary">
			{links.map((link) => (
				<a href={link.href} class="transition hover:text-primary">
					{link.label}
				</a>
			))}
			<a
				href="/guides/best-pickleball-paddles-2026"
				class="btn-primary px-4 py-2 text-sm shadow-sm"
			>
				Best Picks
			</a>
		</nav>

		<button
			type="button"
			id="mobile-nav-toggle"
			class="inline-flex items-center justify-center rounded-[var(--radius-md)] border border-border p-2 text-ink lg:hidden"
			aria-expanded="false"
			aria-controls="mobile-nav"
			aria-label="Open menu"
		>
			<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
			</svg>
		</button>
	</div>

	<nav
		id="mobile-nav"
		class="hidden border-t border-border bg-surface px-4 py-4 lg:hidden"
		aria-label="Mobile"
	>
		<ul class="flex flex-col gap-1">
			{links.map((link) => (
				<li>
					<a
						href={link.href}
						class="block rounded-[var(--radius-md)] px-3 py-3 text-base font-semibold text-ink hover:bg-bg hover:text-primary"
					>
						{link.label}
					</a>
				</li>
			))}
			<li class="pt-2">
				<a href="/guides/best-pickleball-paddles-2026" class="btn-primary w-full">Best Picks</a>
			</li>
		</ul>
	</nav>
</header>

<script>
	const toggle = document.getElementById('mobile-nav-toggle');
	const panel = document.getElementById('mobile-nav');
	toggle?.addEventListener('click', () => {
		const open = panel?.classList.toggle('hidden') === false;
		toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
		toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
	});
</script>
