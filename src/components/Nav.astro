---
import SiteLogo from './SiteLogo.astro';
import { SITE_REGION } from '../lib/site';

const links = [
	{ href: '/gear/paddles', label: 'Paddles' },
	{ href: '/gear/shoes', label: 'Shoes' },
	{ href: '/gear/balls', label: 'Balls' },
	{ href: '/gear/bags', label: 'Bags' },
	{ href: '/gear/nets', label: 'Nets' },
	{ href: '/gear/accessories', label: 'Accessories' },
	{ href: '/guides', label: 'Guides' },
	{ href: '/news', label: 'News' },
];

const otherRegion = SITE_REGION === 'ca' ? 'us' : 'ca';
const otherStore = SITE_REGION === 'ca' ? 'Amazon.com' : 'Amazon.ca';
const otherLabel = SITE_REGION === 'ca' ? 'US site' : 'Canada site';
const switchHref = `/go/${otherRegion}?next=${encodeURIComponent(Astro.url.pathname || '/')}`;
---

<header class="sticky top-0 z-50 border-b border-border bg-surface/95 backdrop-blur-md">
	<div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
		<SiteLogo />

		<nav
			class="hidden min-w-0 flex-1 items-center justify-end gap-4 overflow-x-auto text-sm font-semibold text-ink-muted lg:flex xl:gap-6"
			aria-label="Primary"
		>
			{links.map((link) => (
				<a href={link.href} class="shrink-0 transition hover:text-primary">
					{link.label}
				</a>
			))}
			<a
				href="/guides/best-pickleball-paddles-2026"
				class="btn-primary shrink-0 px-4 py-2 text-sm shadow-sm"
			>
				Best Picks
			</a>
			<a
				href={switchHref}
				class="shrink-0 rounded-[var(--radius-md)] border border-border px-3 py-2 text-xs font-semibold text-ink-muted transition hover:border-primary hover:text-primary"
			>
				{otherLabel}
				<span class="text-ink-faint"> · {otherStore}</span>
			</a>
		</nav>

		<button
			type="button"
			id="mobile-nav-toggle"
			class="inline-flex items-center justify-center rounded-[var(--radius-md)] border border-border p-2 text-ink lg:hidden"
			aria-expanded="false"
			aria-controls="mobile-nav"
			aria-label="Open menu"
		>
			<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
			</svg>
		</button>
	</div>

	<nav
		id="mobile-nav"
		class="hidden border-t border-border bg-surface px-4 py-4 lg:hidden"
		aria-label="Mobile"
	>
		<ul class="flex flex-col gap-1">
			{links.map((link) => (
				<li>
					<a
						href={link.href}
						class="block rounded-[var(--radius-md)] px-3 py-3 text-base font-semibold text-ink hover:bg-bg hover:text-primary"
					>
						{link.label}
					</a>
				</li>
			))}
			<li class="pt-2">
				<a href="/guides/best-pickleball-paddles-2026" class="btn-primary w-full">Best Picks</a>
			</li>
			<li>
				<a
					href={switchHref}
					class="block rounded-[var(--radius-md)] px-3 py-3 text-base font-semibold text-ink hover:bg-bg hover:text-primary"
				>
					{otherLabel} · {otherStore}
				</a>
			</li>
		</ul>
	</nav>
</header>

<script>
	const toggle = document.getElementById('mobile-nav-toggle');
	const panel = document.getElementById('mobile-nav');
	toggle?.addEventListener('click', () => {
		const open = panel?.classList.toggle('hidden') === false;
		toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
		toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
	});
</script>
