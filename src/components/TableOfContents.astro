---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
	title?: string;
}

const { headings, title = 'On this page' } = Astro.props;
const filtered = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

{filtered.length > 0 && (
	<nav
		aria-label="Table of contents"
		class="rounded-2xl border border-zinc-200 bg-white p-4 lg:sticky lg:top-24"
	>
		<p class="text-xs font-bold uppercase tracking-wider text-emerald-700">{title}</p>
		<ol class="mt-3 space-y-2 text-sm">
			{filtered.map((heading) => (
				<li class:list={[heading.depth === 3 ? 'ml-3' : '']}>
					<a
						href={`#${heading.slug}`}
						class="text-zinc-600 transition hover:text-emerald-700"
					>
						{heading.text}
					</a>
				</li>
			))}
		</ol>
	</nav>
)}
