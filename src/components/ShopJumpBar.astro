---
/**
 * Mobile shop shortcuts so paddles and balls stay one tap away.
 * Docked in Layout below .site-scroll (not position:fixed) so in-flow
 * Amazon Shop CTAs cannot sit under the bar while free-scrolling.
 * Hidden on large screens where the nav already has catalog links.
 */
---

<nav
	class="shop-jump-bar z-40 max-w-full shrink-0 border-t border-border bg-surface/95 px-3 py-2.5 backdrop-blur-md lg:hidden"
	aria-label="Shop shortcuts"
>
	<div class="mx-auto flex min-w-0 max-w-7xl gap-2">
		<a href="/gear/paddles" class="btn-primary min-w-0 flex-1 px-3 py-2.5 text-center text-sm">Shop paddles</a>
		<a href="/gear/balls" class="btn-secondary min-w-0 flex-1 px-3 py-2.5 text-center text-sm">Shop balls</a>
	</div>
</nav>
