---
import Schema from './Schema.astro';
import { absoluteUrl } from '../lib/seo';
import { normalizeBreadcrumbItems, type BreadcrumbItem } from '../lib/breadcrumbs';

interface Props {
	items: BreadcrumbItem[];
}

const { items } = Astro.props;
const crumbs = normalizeBreadcrumbItems(items);

const jsonLd = {
	'@type': 'BreadcrumbList',
	itemListElement: crumbs.map((item, index) => {
		const path = item.href ?? (index === 0 ? '/' : undefined);
		return {
			'@type': 'ListItem',
			position: index + 1,
			name: item.label,
			...(path ? { item: absoluteUrl(path) } : {}),
		};
	}),
};
---

<nav aria-label="Breadcrumb" class="mb-6">
	<ol class="flex flex-wrap items-center gap-2 text-sm text-zinc-600">
		{crumbs.map((item, index) => (
			<li class="inline-flex items-center gap-2">
				{index > 0 && <span class="text-zinc-400" aria-hidden="true">/</span>}
				{item.href && index < crumbs.length - 1 ? (
					<a href={item.href} class="inline-flex min-h-11 items-center font-medium transition hover:text-emerald-800">
						{item.label}
					</a>
				) : (
					<span class="inline-flex min-h-11 items-center font-semibold text-zinc-900" aria-current={index === crumbs.length - 1 ? 'page' : undefined}>
						{item.label}
					</span>
				)}
			</li>
		))}
	</ol>
</nav>

<Schema data={jsonLd} />
