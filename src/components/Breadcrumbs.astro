---
interface Crumb {
	label: string;
	href?: string;
}

interface Props {
	items: Crumb[];
}

const { items } = Astro.props;
const site = 'https://thepickleballcourt.ca';

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: items.map((item, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: item.label,
		...(item.href ? { item: new URL(item.href, site).href } : {}),
	})),
};
---

<nav aria-label="Breadcrumb" class="mb-6">
	<ol class="flex flex-wrap items-center gap-2 text-sm text-zinc-600">
		{items.map((item, index) => (
			<li class="inline-flex items-center gap-2">
				{index > 0 && <span class="text-zinc-400" aria-hidden="true">/</span>}
				{item.href && index < items.length - 1 ? (
					<a href={item.href} class="font-medium transition hover:text-emerald-700">
						{item.label}
					</a>
				) : (
					<span class="font-semibold text-zinc-900" aria-current={index === items.length - 1 ? 'page' : undefined}>
						{item.label}
					</span>
				)}
			</li>
		))}
	</ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
