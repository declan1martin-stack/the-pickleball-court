---
import AffiliateButton from './AffiliateButton.astro';
import SmartImage from './SmartImage.astro';
import {
	getAffiliateUrl,
	getPriceTier,
	getProductById,
	getShopCtaLabel,
	productImageAlt,
} from '../lib/products';
import { getPartnerOffers } from '../lib/partners';
import { AMAZON_STORE } from '../lib/site';
import { marketizeCopy } from '../lib/marketCopy';
import { truncateOnWordBoundary } from '../lib/featureText';

interface Props {
	productId: string;
	eyebrow?: string;
	/** How the 4:3 product photo is fit. Default `contain` shows the whole product; pass `cover` to crop. */
	imageFit?: 'cover' | 'contain';
	/** Optional image alt. Use when `brand` is already in `name` so the default does not double it. */
	alt?: string;
}

const { productId, eyebrow = 'Top pick', imageFit = 'contain', alt } = Astro.props;
const imageClass =
	imageFit === 'contain'
		? 'h-full w-full object-contain transition duration-500 motion-reduce:transition-none md:group-hover:scale-105'
		: 'h-full w-full object-cover';
const imageBoxClass =
	imageFit === 'contain'
		? 'relative aspect-[4/3] overflow-hidden bg-white max-md:rounded-t-2xl md:aspect-auto md:min-h-full md:rounded-l-2xl'
		: 'relative aspect-[4/3] overflow-hidden bg-zinc-100 max-md:rounded-t-2xl md:aspect-auto md:min-h-full md:rounded-l-2xl';
const product = getProductById(productId);
const partnerOffers = product ? getPartnerOffers(product) : [];
const imageAlt = (alt ?? '').trim() || (product ? productImageAlt(product) : '');
const tier = product ? getPriceTier(product.price) : '';
---

{product ? (
	<aside class="group my-8 rounded-2xl border border-emerald-200 bg-white shadow-sm">
		<div class="grid gap-0 md:grid-cols-[220px_1fr]">
			<div class={imageBoxClass}>
				<SmartImage
					src={product.imageUrl}
					alt={imageAlt}
					width={440}
					height={330}
					loading="lazy"
					decoding="async"
					class={imageClass}
				/>
			</div>
			<div class="flex flex-col p-5 sm:p-6">
				<p class="text-xs font-bold uppercase tracking-wider text-emerald-800">{eyebrow}</p>
				<h3 class="mt-1 text-xl font-black text-zinc-900">{product.name}</h3>
				<p class="mt-1 text-sm font-semibold text-zinc-500">{product.brand}</p>
				<p class="mt-3 text-sm leading-relaxed text-zinc-600">{marketizeCopy(product.description)}</p>
				<p class="mt-3 text-xs text-zinc-500" title={`Catalog band ${tier}`}>
					Approximate price tier — check current price
				</p>
				<ul class="mt-4 space-y-2 text-sm text-zinc-700">
					{product.features.map((feature) => (
						<li class="flex gap-2">
							<span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-600" aria-hidden="true" />
							<span>{truncateOnWordBoundary(marketizeCopy(feature))}</span>
						</li>
					))}
				</ul>
				<div class="mt-5 flex flex-col gap-2">
					<AffiliateButton
						href={getAffiliateUrl(product)}
						label={getShopCtaLabel(product, AMAZON_STORE)}
						productId={product.id}
						partner="amazon"
					/>
					{partnerOffers.map((offer) => (
						<AffiliateButton
							href={offer.href}
							label={offer.label}
							variant="secondary"
							network="partner"
							partner={offer.id}
							productId={product.id}
						/>
					))}
				</div>
			</div>
		</div>
	</aside>
) : (
	<p class="my-6 rounded-xl border border-dashed border-zinc-300 bg-zinc-50 px-4 py-3 text-sm text-zinc-600">
		Product spotlight unavailable: unknown product ID <code>{productId}</code>.
	</p>
)}
