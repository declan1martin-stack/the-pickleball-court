---
import AffiliateButton from './AffiliateButton.astro';
import SmartImage from './SmartImage.astro';
import { getAffiliateUrl, getPriceTier, getProductById, getShopCtaLabel } from '../lib/products';
import { getPartnerOffers } from '../lib/partners';
import { AMAZON_STORE } from '../lib/site';
import { marketizeCopy } from '../lib/marketCopy';

interface Props {
	productId: string;
	eyebrow?: string;
}

const { productId, eyebrow = 'Top pick' } = Astro.props;
const product = getProductById(productId);
const priceLabel = product
	? `Approximate price tier ${getPriceTier(product.price)}`
	: '';
const partnerOffers = product ? getPartnerOffers(product) : [];
---

{product ? (
	<aside class="my-8 overflow-hidden rounded-2xl border border-emerald-200 bg-white shadow-sm">
		<div class="grid gap-0 md:grid-cols-[220px_1fr]">
			<div class="relative aspect-[4/3] bg-zinc-100 md:aspect-auto md:min-h-full">
				<SmartImage
					src={product.imageUrl}
					alt={`${product.brand} ${product.name}`}
					width={440}
					height={330}
					loading="lazy"
					decoding="async"
					class="h-full w-full object-cover"
				/>
			</div>
			<div class="flex flex-col p-5 sm:p-6">
				<p class="text-xs font-bold uppercase tracking-wider text-emerald-800">{eyebrow}</p>
				<h3 class="mt-1 text-xl font-black text-zinc-900">{product.name}</h3>
				<p class="mt-1 text-sm font-semibold text-zinc-500">{product.brand}</p>
				<p class="mt-3 text-sm leading-relaxed text-zinc-600">{marketizeCopy(product.description)}</p>
				<p class="mt-3 text-xs text-zinc-500">
					{priceLabel} — confirm the current price on {AMAZON_STORE}.
				</p>
				<ul class="mt-4 space-y-2 text-sm text-zinc-700">
					{product.features.map((feature) => (
						<li class="flex gap-2">
							<span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-600" aria-hidden="true" />
							<span>{marketizeCopy(feature)}</span>
						</li>
					))}
				</ul>
				<div class="mt-5 flex flex-col gap-2">
					<AffiliateButton
						href={getAffiliateUrl(product)}
						label={getShopCtaLabel(product, AMAZON_STORE)}
						productId={product.id}
						partner="amazon"
					/>
					{partnerOffers.map((offer) => (
						<AffiliateButton
							href={offer.href}
							label={offer.label}
							variant="secondary"
							network="partner"
							partner={offer.id}
							productId={product.id}
						/>
					))}
				</div>
			</div>
		</div>
	</aside>
) : (
	<p class="my-6 rounded-xl border border-dashed border-zinc-300 bg-zinc-50 px-4 py-3 text-sm text-zinc-600">
		Product spotlight unavailable: unknown product ID <code>{productId}</code>.
	</p>
)}
