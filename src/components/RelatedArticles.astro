---
interface RelatedArticle {
	slug: string;
	title: string;
	description: string;
	category: string;
}

interface Props {
	articles: RelatedArticle[];
	heading?: string;
}

const { articles, heading = 'Related guides' } = Astro.props;
const items = articles.slice(0, 3);
---

{items.length > 0 && (
	<section class="my-10" aria-labelledby="related-articles-heading">
		<h2 id="related-articles-heading" class="text-2xl font-black tracking-tight text-zinc-900">
			{heading}
		</h2>
		<ul class="mt-5 grid gap-4 md:grid-cols-3">
			{items.map((article) => (
				<li>
					<a
						href={`/guides/${article.slug}`}
						class="block h-full rounded-2xl border border-zinc-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-md"
					>
						<p class="text-xs font-bold uppercase tracking-wider text-emerald-700">{article.category}</p>
						<h3 class="mt-2 text-base font-bold text-zinc-900">{article.title}</h3>
						<p class="mt-2 line-clamp-3 text-sm text-zinc-600">{article.description}</p>
					</a>
				</li>
			))}
		</ul>
	</section>
)}
