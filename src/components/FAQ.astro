---
import Schema from './Schema.astro';

interface FaqItem {
	question: string;
	answer: string;
}

interface Props {
	items: FaqItem[];
	heading?: string;
	/** Set false when the page already emits FAQPage in the Layout @graph. */
	includeSchema?: boolean;
}

const { items, heading = 'Frequently asked questions', includeSchema = true } = Astro.props;

type AnswerPart = { kind: 'text'; value: string } | { kind: 'link'; label: string; href: string };

/** Guide links written as markdown. Other answers, including older /gear/ links, stay plain text. */
const guideLinkSource = String.raw`\[([^\]]+)\]\((\/guides\/[^)\s]+)\)`;

function guideLinkRe(): RegExp {
	return new RegExp(guideLinkSource, 'g');
}

function answerParts(answer: string): AnswerPart[] {
	const parts: AnswerPart[] = [];
	const re = guideLinkRe();
	let last = 0;
	for (const match of answer.matchAll(re)) {
		const index = match.index ?? 0;
		if (index > last) parts.push({ kind: 'text', value: answer.slice(last, index) });
		parts.push({ kind: 'link', label: match[1], href: match[2] });
		last = index + match[0].length;
	}
	if (last < answer.length) parts.push({ kind: 'text', value: answer.slice(last) });
	if (parts.length === 0) parts.push({ kind: 'text', value: answer });
	return parts;
}

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: items.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.answer.replace(guideLinkRe(), '$1'),
		},
	})),
};
---

{items.length > 0 && (
	<section class="my-10" aria-labelledby="faq-heading">
		<h2 id="faq-heading" class="font-display text-2xl font-bold tracking-tight text-ink">{heading}</h2>
		<div class="mt-5 divide-y divide-border rounded-[var(--radius-lg)] border border-border bg-surface">
			{items.map((item, index) => (
				<details class="group px-4 py-1 sm:px-5" open={index === 0}>
					<summary class="cursor-pointer list-none py-4 font-semibold text-ink marker:content-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary [&::-webkit-details-marker]:hidden">
						<span class="flex items-start justify-between gap-4">
							<span>{item.question}</span>
							<span class="mt-0.5 text-primary transition group-open:rotate-45" aria-hidden="true">+</span>
						</span>
					</summary>
					<p class="pb-4 text-sm leading-relaxed text-ink-muted">
						{answerParts(item.answer).map((part) =>
							part.kind === 'link' ? (
								<a href={part.href} class="font-semibold text-emerald-800 underline">{part.label}</a>
							) : (
								part.value
							),
						)}
					</p>
				</details>
			))}
		</div>
		{includeSchema && <Schema data={jsonLd} />}
	</section>
)}
