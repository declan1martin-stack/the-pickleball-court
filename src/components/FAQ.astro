---
interface FaqItem {
	question: string;
	answer: string;
}

interface Props {
	items: FaqItem[];
	heading?: string;
}

const { items, heading = 'Frequently asked questions' } = Astro.props;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: items.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.answer,
		},
	})),
};
---

{items.length > 0 && (
	<section class="my-10" aria-labelledby="faq-heading">
		<h2 id="faq-heading" class="text-2xl font-black tracking-tight text-zinc-900">{heading}</h2>
		<div class="mt-5 divide-y divide-zinc-200 rounded-2xl border border-zinc-200 bg-white">
			{items.map((item, index) => (
				<details class="group px-4 py-1 sm:px-5" open={index === 0}>
					<summary class="cursor-pointer list-none py-4 font-semibold text-zinc-900 marker:content-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 [&::-webkit-details-marker]:hidden">
						<span class="flex items-start justify-between gap-4">
							<span>{item.question}</span>
							<span class="mt-0.5 text-emerald-700 transition group-open:rotate-45" aria-hidden="true">+</span>
						</span>
					</summary>
					<p class="pb-4 text-sm leading-relaxed text-zinc-600">{item.answer}</p>
				</details>
			))}
		</div>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</section>
)}
