---
interface Props {
	/** Only render when a real rating exists in data — never invent one. */
	rating?: number | null;
	max?: number;
	label?: string;
}

const { rating = null, max = 5, label = 'Rating' } = Astro.props;
const show = typeof rating === 'number' && Number.isFinite(rating) && rating > 0;
const clamped = show ? Math.min(Math.max(rating, 0), max) : 0;
const filled = Math.round(clamped);
---

{show && (
	<div class="inline-flex items-center gap-2" aria-label={`${label}: ${clamped} out of ${max}`}>
		<div class="flex gap-0.5" aria-hidden="true">
			{Array.from({ length: max }, (_, i) => (
				<span class:list={['text-sm', i < filled ? 'text-amber-500' : 'text-zinc-300']}>★</span>
			))}
		</div>
		<span class="text-sm font-semibold text-zinc-700">{clamped.toFixed(1)}</span>
	</div>
)}
