---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import Disclosure from '../components/Disclosure.astro';
import MarketStoreNote from '../components/MarketStoreNote.astro';
import LatestWeeklyUpdates from '../components/LatestWeeklyUpdates.astro';
import { getFeaturedArticles, getAllArticles } from '../lib/articles';
import { getProductsByIds } from '../lib/products';
import { AMAZON_STORE, MARKET_COUNTRY, MARKET_LABEL, MARKET_PLAYERS } from '../lib/site';
import { marketizeCopy } from '../lib/marketCopy';
import SmartImage from '../components/SmartImage.astro';

/** Mix value + performance so Featured Gear is not three flagships. */
const featured = getProductsByIds([
	'joola-vision-c15',
	'selkirk-slk-halo-control-xl',
	'joola-perseus-16mm',
]);
const featuredGuides = await getFeaturedArticles(4);
const allArticles = await getAllArticles();
const comparisons = allArticles.filter((article) => article.data.type === 'comparison').slice(0, 3);

const categories = [
	{
		href: '/gear/paddles',
		title: 'Paddles',
		blurb: `JOOLA, Selkirk, and Six Zero paddles built for ${MARKET_LABEL} court conditions.`,
		accent: 'from-primary to-primary-dark',
	},
	{
		href: '/gear/shoes',
		title: 'Shoes',
		blurb: 'Court-stable Skechers and ASICS shoes for hard stops and lateral cuts.',
		accent: 'from-primary-dark to-footer',
	},
	{
		href: '/gear/balls',
		title: 'Balls',
		blurb: 'Outdoor X-40, indoor X-26, Fuse, and Dura Fast 40 packs for clubs and gyms.',
		accent: 'from-secondary to-secondary-dark',
	},
	{
		href: '/gear/bags',
		title: 'Bags',
		blurb: 'Sling bags, backpacks, and tour bags for paddles and club-night gear.',
		accent: 'from-primary to-secondary',
	},
	{
		href: '/gear/nets',
		title: 'Nets',
		blurb: 'Regulation portable nets for driveways, parks, and backyard courts.',
		accent: 'from-secondary-dark to-primary-dark',
	},
	{
		href: '/gear/apparel',
		title: 'Apparel',
		blurb: `Skorts, UV arm sleeves, and court wear for outdoor ${MARKET_LABEL} sessions.`,
		accent: 'from-accent/90 to-secondary',
	},
	{
		href: '/gear/accessories',
		title: 'Accessories',
		blurb: 'Overgrips, edge guard, and tungsten tape — small upgrades that add up.',
		accent: 'from-footer to-primary-dark',
	},
];

const pillars = [
	{
		href: '/guides/how-to-choose-a-pickleball-paddle',
		title: 'How to Choose a Pickleball Paddle',
		blurb: 'The beginner-to-intermediate pillar for weight, grip, core, and face decisions.',
	},
	{
		href: '/guides/how-we-define-skill-tiers',
		title: 'Skill Tiers: Beginner → Pro',
		blurb: 'How we label products by skill — so beginner and advanced mean the same thing everywhere.',
	},
	{
		href: '/guides/pickleball-paddles-under-100',
		title: 'Paddles Under $100',
		blurb: 'A practical $30–$100 buyer’s guide for driveway, weekly club, and value upgrades.',
	},
	{
		href: '/guides/best-pickleball-paddles-2026',
		title: 'Best Pickleball Paddles (2026)',
		blurb: 'Picks by playing style — control, power, spin, and all-court.',
	},
	{
		href: '/guides/best-pickleball-shoes-2026',
		title: 'Best Pickleball Shoes (2026)',
		blurb: `Court shoes that protect joints on ${MARKET_LABEL} hard courts.`,
	},
	{
		href: '/guides/pickleball-paddle-foam-cores-explained',
		title: 'Foam Cores Explained',
		blurb: 'What full-foam and Quad Density marketing actually mean before you upgrade.',
	},
];
---

<Layout
	title={`${MARKET_LABEL} Pickleball Gear Guides`}
	description={`Compare paddles, court shoes, balls, bags, apparel, and nets for ${MARKET_PLAYERS} — with practical buying guides and store links.`}
	ogImage="/og-default.png"
	canonicalPath="/"
>
	<section class="relative overflow-hidden bg-primary-dark text-white">
		<div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(46,125,91,0.35),_transparent_45%),radial-gradient(circle_at_bottom_left,_rgba(255,107,53,0.18),_transparent_40%)]" />
		<div class="relative mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-11">
			<p class="font-display text-sm font-bold uppercase tracking-[0.2em] text-accent">{MARKET_LABEL} Pickleball Gear Hub</p>
			<h1 class="font-display mt-3 max-w-4xl text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-[48px]">
				The Definitive Guide to {MARKET_LABEL} Pickleball
			</h1>
			<p class="mt-4 max-w-2xl text-lg leading-relaxed text-footer-text">
				Original buying guides and catalog picks for paddles, footwear, balls, bags, apparel, and portable nets — built for {MARKET_LABEL} shoppers and real courts in {MARKET_COUNTRY}.
			</p>
			<div class="mt-5 flex flex-col gap-3 sm:flex-row">
				<a href="/guides/how-to-choose-a-pickleball-paddle" class="btn-primary">
					Start with the paddle guide
				</a>
				<a href="/guides" class="btn-secondary border-white/40 text-white hover:border-white hover:bg-white hover:text-primary">
					Browse all guides
				</a>
			</div>
		</div>
	</section>

	<LatestWeeklyUpdates />

	<section class="border-b border-border bg-surface">
		<div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8" aria-labelledby="featured-heading">
			<div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
				<div>
					<h2 id="featured-heading" class="font-display text-3xl font-bold tracking-tight text-ink">Featured Gear</h2>
					<p class="mt-2 max-w-2xl text-ink-muted">
						Top searched paddles from our {MARKET_LABEL} gear catalog. Price tiers are approximate — confirm on {AMAZON_STORE}.
					</p>
				</div>
				<a href="/gear/paddles" class="link-brand text-sm">See all paddles →</a>
			</div>
			<div class="mb-4">
				<Disclosure compact />
				<MarketStoreNote compact />
			</div>
			<div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
				{featured.map((product) => (
					<ProductCard product={product} />
				))}
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8" aria-labelledby="pillars-heading">
		<div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
			<div class="max-w-2xl">
				<h2 id="pillars-heading" class="font-display text-3xl font-bold tracking-tight text-ink">Pillar guides</h2>
				<p class="mt-3 text-ink-muted">Start with the deep guides that rank for high-intent {MARKET_LABEL} searches.</p>
			</div>
			<a href="/guides" class="link-brand text-sm">All guides →</a>
		</div>
		<div class="grid gap-5 md:grid-cols-2">
			{pillars.map((pillar) => (
				<a
					href={pillar.href}
					class="rounded-[var(--radius-lg)] border border-border bg-surface p-6 shadow-[var(--shadow-sm)] transition hover:-translate-y-0.5 hover:shadow-[var(--shadow-md)]"
				>
					<h3 class="font-display text-xl font-bold text-ink">{pillar.title}</h3>
					<p class="mt-2 text-sm leading-relaxed text-ink-muted">{pillar.blurb}</p>
				</a>
			))}
		</div>
	</section>

	<section class="border-y border-border bg-surface">
		<div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8" aria-labelledby="categories-heading">
			<div class="mb-4 max-w-2xl">
				<h2 id="categories-heading" class="font-display text-3xl font-bold tracking-tight text-ink">Shop by Category</h2>
				<p class="mt-2 text-ink-muted">Transactional category pages backed by our curated product catalog.</p>
			</div>
			<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
				{categories.map((category) => (
					<a
						href={category.href}
						class={`group relative overflow-hidden rounded-[var(--radius-lg)] bg-gradient-to-br ${category.accent} p-6 text-white shadow-[var(--shadow-md)] transition hover:-translate-y-0.5 hover:shadow-[var(--shadow-lg)]`}
					>
						<h3 class="font-display text-2xl font-bold">{category.title}</h3>
						<p class="mt-3 text-sm leading-relaxed text-white/85">{category.blurb}</p>
						<span class="mt-6 inline-flex text-sm font-bold text-accent transition group-hover:translate-x-1">
							View catalog →
						</span>
					</a>
				))}
			</div>
		</div>
	</section>

	{comparisons.length > 0 && (
		<section class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8" aria-labelledby="comparisons-heading">
			<div class="mb-4 max-w-2xl">
				<h2 id="comparisons-heading" class="font-display text-3xl font-bold tracking-tight text-ink">Featured comparisons</h2>
				<p class="mt-2 text-ink-muted">High-converting brand and category matchups for players ready to choose.</p>
			</div>
			<ul class="grid gap-5 md:grid-cols-3">
				{comparisons.map((article) => (
					<li>
						<a
							href={`/guides/${article.data.slug}`}
							class="block h-full overflow-hidden rounded-[var(--radius-lg)] border border-border bg-surface transition hover:-translate-y-0.5 hover:shadow-[var(--shadow-md)]"
						>
							<SmartImage
								src={article.data.heroImage}
								alt={article.data.heroAlt}
								width={800}
								height={450}
								loading="lazy"
								decoding="async"
								class="aspect-[16/9] w-full object-cover"
							/>
							<div class="p-5">
								<p class="font-display text-xs font-bold uppercase tracking-wider text-secondary">Comparison</p>
								<h3 class="font-display mt-2 text-lg font-bold text-ink">{article.data.title}</h3>
								<p class="mt-2 line-clamp-3 text-sm text-ink-muted">{marketizeCopy(article.data.description)}</p>
							</div>
						</a>
					</li>
				))}
			</ul>
		</section>
	)}

	{featuredGuides.length > 0 && (
		<section class="border-t border-border bg-secondary/5">
			<div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8" aria-labelledby="featured-guides-heading">
				<h2 id="featured-guides-heading" class="font-display text-3xl font-bold tracking-tight text-ink">Editor’s featured reads</h2>
				<ul class="mt-4 grid gap-4 md:grid-cols-2">
					{featuredGuides.map((article) => (
						<li>
							<a href={`/guides/${article.data.slug}`} class="flex gap-4 rounded-[var(--radius-lg)] border border-border bg-surface p-4 transition hover:border-primary/30 hover:shadow-[var(--shadow-sm)]">
								<SmartImage
									src={article.data.heroImage}
									alt={article.data.heroAlt}
									width={160}
									height={96}
									loading="lazy"
									decoding="async"
									class="h-24 w-36 shrink-0 rounded-[var(--radius-md)] object-cover"
								/>
								<div>
									<p class="font-display text-xs font-bold uppercase tracking-wider text-secondary">{article.data.category}</p>
									<h3 class="font-display mt-1 font-bold text-ink">{article.data.title}</h3>
								</div>
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>
	)}
</Layout>
