---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Canadian Pickleball Gear & Court Guides">
	<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
		<h1 class="text-4xl sm:text-5xl font-black tracking-tight text-zinc-900">
			Find the right pickleball gear for Canadian courts
		</h1>
		<p class="mt-4 text-lg text-zinc-600 max-w-2xl">
			Premium paddle, footwear, and net guides built for high-intent shoppers across Canada.
		</p>
	</section>
</Layout>
