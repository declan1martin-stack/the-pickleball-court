---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import RelatedNews from '../../components/RelatedNews.astro';
import { resolveAuthor, authorPath } from '../../data/authors';
import {
	formatNewsDate,
	getAllNews,
	getRelatedNews,
	newsPath,
	newsSlug,
	type NewsEntry,
} from '../../lib/news';
import { absoluteUrl, articleSchema, clampMetaDescription } from '../../lib/seo';

export async function getStaticPaths() {
	const entries = await getAllNews();
	return entries.map((entry) => ({
		params: { slug: newsSlug(entry) },
		props: { entry },
	}));
}

interface Props {
	entry: NewsEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const author = resolveAuthor(entry.data.author);
const path = newsPath(entry);
const description = clampMetaDescription(entry.data.summary);
const allNews = await getAllNews();
const relatedNews = getRelatedNews(allNews, entry, 3);
const isRoundup = entry.data.type === 'roundup';
const heroImage = entry.data.heroImage;
const heroAlt = entry.data.heroAlt ?? entry.data.title;
const ogImage = heroImage ?? '/favicon.svg';
---

<Layout
	title={entry.data.title}
	description={description}
	canonicalPath={path}
	ogType="article"
	ogImage={ogImage}
	publishDate={entry.data.date}
	updatedDate={entry.data.date}
	jsonLd={articleSchema({
		title: entry.data.title,
		description: entry.data.summary,
		path,
		image: absoluteUrl(ogImage),
		author: author.name,
		authorUrl: absoluteUrl(authorPath(author.id)),
		publishDate: entry.data.date,
		updatedDate: entry.data.date,
	})}
>
	<article class="border-b border-border bg-surface">
		<div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
			<Breadcrumbs
				items={[
					{ label: 'Home', href: '/' },
					{ label: 'News', href: '/news' },
					{ label: entry.data.title },
				]}
			/>
			<p class="mt-4 text-xs font-semibold uppercase tracking-wide text-secondary">
				<time datetime={entry.data.date.toISOString()}>
					{formatNewsDate(entry.data.date)}
				</time>
			</p>
			<h1 class="mt-3 font-display text-4xl font-extrabold tracking-tight text-ink">
				{entry.data.title}
			</h1>
			<p class="mt-4 text-lg leading-relaxed text-ink-muted">{entry.data.summary}</p>
			<p class="mt-4 text-sm text-ink-faint">
				By <a href={authorPath(author.id)} class="font-semibold text-primary underline">{author.name}</a>
			</p>
			{heroImage && (
				<figure class="mt-8">
					<img
						src={heroImage}
						alt={heroAlt}
						width="1200"
						height="630"
						fetchpriority="high"
						decoding="async"
						class="aspect-[21/9] w-full rounded-[var(--radius-lg)] object-cover object-[center_35%]"
					/>
					{entry.data.heroCredit && (
						<figcaption class="mt-2 text-xs text-ink-faint">{entry.data.heroCredit}</figcaption>
					)}
				</figure>
			)}
		</div>
	</article>

	<div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
		<div class="prose-article max-w-[70ch] text-ink [&_a]:font-semibold [&_a]:text-primary [&_a]:underline [&_p]:my-4 [&_p]:leading-relaxed">
			<Content />
		</div>

		{entry.data.sourceUrl && (
			<p class="mt-8 text-sm text-ink-muted">
				Coverage reference:{' '}
				<a href={entry.data.sourceUrl} rel="noopener noreferrer" class="font-semibold text-primary underline">
					source link
				</a>
				{' '}(paraphrased; not a quotation).
			</p>
		)}

		{entry.data.tags.length > 0 && (
			<ul class="mt-6 flex flex-wrap gap-2">
				{entry.data.tags.map((tag) => (
					<li class="rounded-[var(--radius-pill)] bg-bg px-2.5 py-0.5 text-xs font-semibold text-ink-muted">
						{tag}
					</li>
				))}
			</ul>
		)}

		{isRoundup && (
			<section class="mt-10 rounded-[var(--radius-lg)] border border-border bg-bg p-5" aria-labelledby="roundup-guides-heading">
				<h2 id="roundup-guides-heading" class="font-display text-lg font-bold text-ink">
					Shop the guides behind this week’s news
				</h2>
				<ul class="mt-3 space-y-2 text-sm text-ink-muted">
					<li>
						<a href="/guides/pickleball-paddles-under-100" class="font-semibold text-primary underline">
							Paddles under $100
						</a>
						{' '}— budget / value buying window
					</li>
					<li>
						<a href="/guides/pickleball-paddle-foam-cores-explained" class="font-semibold text-primary underline">
							Foam cores explained
						</a>
						{' '}— decode full-foam and density marketing
					</li>
					<li>
						<a href="/guides/how-we-define-skill-tiers" class="font-semibold text-primary underline">
							Skill tiers
						</a>
						{' '}— match gear to how you actually play
					</li>
					<li>
						<a href="/guides/how-to-choose-a-pickleball-paddle" class="font-semibold text-primary underline">
							How to choose a paddle
						</a>
						{' '}— full buying pillar
					</li>
				</ul>
			</section>
		)}

		<RelatedNews
			entries={relatedNews}
			heading={isRoundup ? 'More weekly updates' : 'More updates'}
		/>

		<p class="mt-8 text-sm font-semibold">
			<a href="/news" class="link-brand">← All news updates</a>
		</p>

		<AuthorBox author={author} />
	</div>
</Layout>
