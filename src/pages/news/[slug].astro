---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import { resolveAuthor, authorPath } from '../../data/authors';
import { formatNewsDate, getAllNews, newsPath, newsSlug, type NewsEntry } from '../../lib/news';
import { absoluteUrl, articleSchema, clampMetaDescription } from '../../lib/seo';

export async function getStaticPaths() {
	const entries = await getAllNews();
	return entries.map((entry) => ({
		params: { slug: newsSlug(entry) },
		props: { entry },
	}));
}

interface Props {
	entry: NewsEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const author = resolveAuthor(entry.data.author);
const path = newsPath(entry);
const description = clampMetaDescription(entry.data.summary);
---

<Layout
	title={entry.data.title}
	description={description}
	canonicalPath={path}
	ogType="article"
	publishDate={entry.data.date}
	updatedDate={entry.data.date}
	jsonLd={articleSchema({
		title: entry.data.title,
		description: entry.data.summary,
		path,
		image: absoluteUrl('/favicon.svg'),
		author: author.name,
		authorUrl: absoluteUrl(authorPath(author.id)),
		publishDate: entry.data.date,
		updatedDate: entry.data.date,
	})}
>
	<article class="border-b border-border bg-surface">
		<div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
			<Breadcrumbs
				items={[
					{ label: 'Home', href: '/' },
					{ label: 'News', href: '/news' },
					{ label: entry.data.title },
				]}
			/>
			<p class="mt-4 text-xs font-semibold uppercase tracking-wide text-secondary">
				<time datetime={entry.data.date.toISOString()}>
					{formatNewsDate(entry.data.date)}
				</time>
			</p>
			<h1 class="mt-3 font-display text-4xl font-extrabold tracking-tight text-ink">
				{entry.data.title}
			</h1>
			<p class="mt-4 text-lg leading-relaxed text-ink-muted">{entry.data.summary}</p>
			<p class="mt-4 text-sm text-ink-faint">
				By <a href={authorPath(author.id)} class="font-semibold text-primary underline">{author.name}</a>
			</p>
		</div>
	</article>

	<div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
		<div class="prose-article max-w-[70ch] text-ink [&_a]:font-semibold [&_a]:text-primary [&_a]:underline [&_p]:my-4 [&_p]:leading-relaxed">
			<Content />
		</div>

		{entry.data.sourceUrl && (
			<p class="mt-8 text-sm text-ink-muted">
				Coverage reference:{' '}
				<a href={entry.data.sourceUrl} rel="noopener noreferrer" class="font-semibold text-primary underline">
					source link
				</a>
				{' '}(paraphrased; not a quotation).
			</p>
		)}

		{entry.data.tags.length > 0 && (
			<ul class="mt-6 flex flex-wrap gap-2">
				{entry.data.tags.map((tag) => (
					<li class="rounded-[var(--radius-pill)] bg-bg px-2.5 py-0.5 text-xs font-semibold text-ink-muted">
						{tag}
					</li>
				))}
			</ul>
		)}

		<p class="mt-8 text-sm font-semibold">
			<a href="/news" class="link-brand">← All news updates</a>
		</p>

		<AuthorBox author={author} />
	</div>
</Layout>
