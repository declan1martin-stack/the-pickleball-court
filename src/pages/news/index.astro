---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NewsCard from '../../components/NewsCard.astro';
import {
	getNewsForMarket,
	newsCardMedia,
	newsCategory,
	newsPath,
	type NewsEntry,
} from '../../lib/news';
import { MARKET_LABEL, SITE_NAME } from '../../lib/site';

const posts = await getNewsForMarket();
const usedSrcs = new Set<string>();

function cardProps(entry: NewsEntry) {
	const media = newsCardMedia(entry, usedSrcs);
	return {
		href: newsPath(entry),
		title: entry.data.title,
		date: entry.data.date,
		category: newsCategory(entry.data.tags),
		summary: entry.data.summary,
		image: media.src,
		imageAlt: media.alt,
		imageCredit: media.credit,
		imageLicense: media.license,
	};
}

const lead = posts[0];
const featureBlock = posts.slice(1, 5);
const gridThree = posts.slice(5, 8);
const wideTwo = posts.slice(8, 10);
const moreList = posts.slice(10);
---

<Layout
	title={`Pickleball News & Updates | ${SITE_NAME}`}
	description={`Short ${MARKET_LABEL} pickleball industry updates — sponsor moves, paddle launches, and brand news for gear shoppers.`}
	canonicalPath="/news"
>
	<section class="border-b border-border bg-surface">
		<div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
			<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'News' }]} />
			<h1 class="mt-4 font-display text-4xl font-extrabold tracking-tight text-ink">Newsroom</h1>
			<p class="mt-3 max-w-2xl text-ink-muted">
				Weekly pickleball news, results, and gear for {MARKET_LABEL} shoppers. For deeper buying advice, browse our
				<a href="/guides" class="font-semibold text-primary underline">guides</a>
				{' '}(start with
				<a href="/guides/pickleball-paddles-under-100" class="font-semibold text-primary underline">paddles under $100</a>
				{' '}or
				<a href="/guides/pickleball-paddle-foam-cores-explained" class="font-semibold text-primary underline">foam cores explained</a>).
			</p>
			<p class="mt-3 text-sm">
				<a href="/news/feed.xml" class="link-brand">RSS feed →</a>
			</p>
		</div>
	</section>

	<div class="news">
		{lead && (
			<section class="sec">
				<NewsCard variant="hero" {...cardProps(lead)} />
			</section>
		)}

		{featureBlock.length > 0 && (
			<section class="sec">
				<div class="sec-head"><h2>This week</h2></div>
				<div class="feature-block">
					<div class="feature-main">
						<NewsCard variant="standard" {...cardProps(featureBlock[0])} />
					</div>
					<div class="feature-list">
						{featureBlock.slice(1).map((entry) => (
							<NewsCard variant="list" {...cardProps(entry)} />
						))}
					</div>
				</div>
			</section>
		)}

		{gridThree.length > 0 && (
			<section class="sec">
				<div class="sec-head">
					<h2>Latest stories</h2>
					<a href="/news/feed.xml">RSS</a>
				</div>
				<div class="grid-3">
					{gridThree.map((entry) => (
						<NewsCard variant="standard" {...cardProps(entry)} />
					))}
				</div>
			</section>
		)}

		{wideTwo.length > 0 && (
			<section class="sec">
				<div class="sec-head"><h2>Features</h2></div>
				<div class="grid-2">
					{wideTwo.map((entry) => (
						<NewsCard variant="standard" {...cardProps(entry)} />
					))}
				</div>
			</section>
		)}

		{moreList.length > 0 && (
			<section class="sec" id="more-from-newsroom">
				<div class="sec-head"><h2>More from the newsroom</h2></div>
				<div class="list-2col">
					{moreList.map((entry) => (
						<NewsCard variant="list" {...cardProps(entry)} />
					))}
				</div>
			</section>
		)}
	</div>
</Layout>

<style>
	.news {
		max-width: 1120px;
		margin: 0 auto;
		padding: 2rem 1.25rem 4rem;
	}

	.sec {
		margin-top: 2.5rem;
	}
	.sec-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1rem;
		border-bottom: 1px solid var(--nc-border);
		padding-bottom: 0.5rem;
	}
	.sec-head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.4rem;
		font-weight: 700;
		color: var(--nc-ink);
	}
	.sec-head a {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--nc-brand);
		text-decoration: none;
	}
	.sec-head a:hover {
		text-decoration: underline;
	}

	.feature-block {
		display: grid;
		grid-template-columns: 1.6fr 1fr;
		gap: var(--nc-gap);
		align-items: start;
	}
	.feature-list {
		display: flex;
		flex-direction: column;
	}

	.grid-3 {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--nc-gap);
	}
	.grid-2 {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--nc-gap);
	}

	.list-2col {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0 2rem;
	}

	@media (max-width: 760px) {
		.feature-block,
		.grid-3,
		.grid-2,
		.list-2col {
			grid-template-columns: 1fr;
		}
	}
</style>
