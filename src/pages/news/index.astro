---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import {
	formatNewsDate,
	getNewsForMarket,
	NEWS_PAGE_SIZE,
	newsHeroMedia,
	newsPath,
	newsSlug,
} from '../../lib/news';
import { MARKET_LABEL, SITE_NAME } from '../../lib/site';

const allNews = await getNewsForMarket();
const totalPages = Math.max(1, Math.ceil(allNews.length / NEWS_PAGE_SIZE));
const pageParam = Number(Astro.url.searchParams.get('page') || '1');
const page = Number.isFinite(pageParam) && pageParam >= 1 ? Math.min(pageParam, totalPages) : 1;
const start = (page - 1) * NEWS_PAGE_SIZE;
const entries = allNews.slice(start, start + NEWS_PAGE_SIZE);
---

<Layout
	title={`Pickleball News & Updates | ${SITE_NAME}`}
	description={`Short ${MARKET_LABEL} pickleball industry updates — sponsor moves, paddle launches, and brand news for gear shoppers.`}
	canonicalPath="/news"
>
	<section class="border-b border-border bg-surface">
		<div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
			<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'News' }]} />
			<h1 class="mt-4 font-display text-4xl font-extrabold tracking-tight text-ink">News & updates</h1>
			<p class="mt-3 max-w-2xl text-ink-muted">
				Short, dated notes and weekly roundups — pro tours, league news, and paddle launches — that affect what{' '}
				{MARKET_LABEL} shoppers see in stores. For deeper buying advice, browse our
				<a href="/guides" class="font-semibold text-primary underline">guides</a>
				{' '}(start with
				<a href="/guides/pickleball-paddles-under-100" class="font-semibold text-primary underline">paddles under $100</a>
				{' '}or
				<a href="/guides/pickleball-paddle-foam-cores-explained" class="font-semibold text-primary underline">foam cores explained</a>).
			</p>
			<p class="mt-3 text-sm">
				<a href="/news/feed.xml" class="link-brand">RSS feed →</a>
			</p>
		</div>
	</section>

	<div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
		<ul class="space-y-6">
			{entries.map((entry) => {
				const slug = newsSlug(entry);
				const href = newsPath(entry);
				const hero = newsHeroMedia(entry);
				return (
					<li
						id={slug}
						class="overflow-hidden rounded-[var(--radius-lg)] border border-border bg-surface shadow-[var(--shadow-sm)]"
					>
						{hero.src && (
							<a href={href} tabindex="-1" aria-hidden="true">
								<img
									src={hero.src}
									alt={hero.alt}
									width="800"
									height="450"
									loading="lazy"
									decoding="async"
									class="aspect-[16/9] w-full object-cover"
								/>
							</a>
						)}
						<div class="p-6">
							<p class="text-xs font-semibold uppercase tracking-wide text-secondary">
								<time datetime={entry.data.date.toISOString()}>
									{formatNewsDate(entry.data.date)}
								</time>
							</p>
							<h2 class="mt-2 font-display text-2xl font-bold text-ink">
								<a href={href} class="hover:text-primary">{entry.data.title}</a>
							</h2>
							<p class="mt-3 text-sm leading-relaxed text-ink-muted">{entry.data.summary}</p>
							{entry.data.tags.length > 0 && (
								<ul class="mt-4 flex flex-wrap gap-2">
									{entry.data.tags.map((tag) => (
										<li class="rounded-[var(--radius-pill)] bg-bg px-2.5 py-0.5 text-xs font-semibold text-ink-muted">
											{tag}
										</li>
									))}
								</ul>
							)}
							<p class="mt-4 text-sm font-semibold">
								<a href={href} class="link-brand">Read update →</a>
							</p>
						</div>
					</li>
				);
			})}
		</ul>

		{totalPages > 1 && (
			<nav class="mt-10 flex items-center justify-between text-sm font-semibold" aria-label="News pagination">
				{page > 1 ? (
					<a href={`/news?page=${page - 1}`} class="link-brand">← Newer</a>
				) : (
					<span class="text-ink-faint">← Newer</span>
				)}
				<span class="text-ink-muted">
					Page {page} of {totalPages}
				</span>
				{page < totalPages ? (
					<a href={`/news?page=${page + 1}`} class="link-brand">Older →</a>
				) : (
					<span class="text-ink-faint">Older →</span>
				)}
			</nav>
		)}
	</div>
</Layout>
