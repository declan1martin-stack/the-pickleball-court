---
import TrustPageLayout from '../layouts/TrustPageLayout.astro';
---

<TrustPageLayout
	title="Contact"
	description="Get in touch with ThePickleballCourt.ca editorial team."
	canonicalPath="/contact"
>
	<p>
		Have a correction, partnership question, or guide request? We read every message related to Canadian pickleball
		gear content.
	</p>
	<h2>Email</h2>
	<p>
		{'{{ TODO: confirm }}'} — replace with your public contact email. Placeholder:
		<a href="mailto:hello@thepickleballcourt.ca">hello@thepickleballcourt.ca</a>
	</p>
	<h2>What to include</h2>
	<ul>
		<li>The page URL you’re writing about</li>
		<li>What needs updating (broken link, outdated advice, missing product)</li>
		<li>Whether you’re a player, coach, retailer, or brand</li>
	</ul>
	<p class="rounded-xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm">
		Form placeholder: {'{{ TODO: confirm }}'} — add a form provider (Formspree, Cloudflare Workers, etc.) when ready.
	</p>
</TrustPageLayout>
