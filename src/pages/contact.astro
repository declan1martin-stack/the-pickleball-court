---
import TrustPageLayout from '../layouts/TrustPageLayout.astro';
import { MARKET_LABEL, SITE_EMAIL, SITE_NAME } from '../lib/site';
---

<TrustPageLayout
	title="Contact"
	description={`Email ${SITE_NAME} with corrections, guide requests, or partnership questions.`}
	canonicalPath="/contact"
>
	<p>
		Have a correction, partnership question, or guide request? We read every message related to {MARKET_LABEL} pickleball
		gear content.
	</p>
	<h2>Email</h2>
	<p>
		<a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
	</p>
	<h2>What to include</h2>
	<ul>
		<li>The page URL you’re writing about</li>
		<li>What needs updating (broken link, outdated advice, missing product)</li>
		<li>Whether you’re a player, coach, retailer, or brand</li>
	</ul>
	<p>
		We aim to reply within a few business days. For Amazon order issues, contact Amazon Support directly — we can’t
		change Amazon fulfillment or pricing.
	</p>
</TrustPageLayout>
