---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import gear from '../../data/gear.json';
import {
	GEAR_CATEGORIES,
	GEAR_CATEGORY_BLURBS,
	GEAR_CATEGORY_LABELS,
	type GearCategory,
} from '../../lib/articles';
import { absoluteUrl, itemListSchema } from '../../lib/seo';
import { MARKET_LABEL, MARKET_PLAYERS } from '../../lib/site';

const categories = GEAR_CATEGORIES.map((slug) => {
	const count = gear.filter((item) => item.category === slug).length;
	return {
		slug,
		href: `/gear/${slug}`,
		label: GEAR_CATEGORY_LABELS[slug as GearCategory],
		blurb: GEAR_CATEGORY_BLURBS[slug as GearCategory],
		count,
	};
});

const totalProducts = categories.reduce((sum, category) => sum + category.count, 0);

const title = 'Pickleball Gear Catalog';
const description =
	'Browse US pickleball paddles, shoes, balls, bags, nets, apparel, accessories, and training gear. Category hubs with relative price tiers — confirm live prices on Amazon.com.';

const itemList = itemListSchema({
	name: title,
	description,
	path: '/gear',
	items: categories.map((category, index) => ({
		name: category.label,
		url: absoluteUrl(category.href),
		position: index + 1,
		description: category.blurb,
	})),
});
---

<Layout title={title} description={description} canonicalPath="/gear" jsonLd={itemList}>
	<section class="border-b border-zinc-200 bg-white">
		<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
			<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Gear', href: '/gear' }]} />
			<p class="text-sm font-bold uppercase tracking-[0.18em] text-emerald-800">{MARKET_LABEL} Gear</p>
			<h1 class="mt-3 max-w-4xl text-4xl font-black tracking-tight text-zinc-900 sm:text-5xl">
				Pickleball gear catalog
			</h1>
			<p class="mt-5 max-w-3xl text-lg leading-relaxed text-zinc-600">
				This hub lists every gear category on {MARKET_LABEL} Pickleball Court — paddles, shoes, balls, bags,
				nets, apparel, accessories, and training. Each category page sorts products by relative price tier
				($–$$$$$); confirm the live listing on Amazon.com before you buy.
			</p>
			<p class="mt-4 max-w-3xl text-base leading-relaxed text-zinc-600">
				Long-form buying advice stays under{' '}
				<a href="/guides" class="font-semibold text-emerald-800 underline">guides</a>. The catalogs below are
				the shopping surfaces for {MARKET_PLAYERS}.
			</p>
			<p class="mt-4 text-sm font-semibold text-zinc-500">
				{categories.length} categories · {totalProducts} products in the catalog
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8" aria-labelledby="gear-categories-heading">
		<h2 id="gear-categories-heading" class="sr-only">Gear categories</h2>
		<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
			{categories.map((category) => (
				<li>
					<a
						href={category.href}
						class="flex h-full flex-col items-start text-left rounded-2xl border border-zinc-200 bg-white p-5 transition hover:border-emerald-200 hover:shadow-md"
					>
						<span class="text-lg font-bold text-zinc-900">{category.label}</span>
						<span class="mt-2 flex-1 text-sm leading-relaxed text-zinc-600">{category.blurb}</span>
						<span class="mt-4 text-xs font-semibold uppercase tracking-wider text-emerald-800">
							{category.count} {category.count === 1 ? 'product' : 'products'} →
						</span>
					</a>
				</li>
			))}
		</ul>
	</section>
</Layout>
