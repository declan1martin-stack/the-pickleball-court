---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GearFilters from '../../components/GearFilters.astro';
import gear from '../../data/gear.json';
import { getArticlesByCategory, CATEGORY_PILLARS } from '../../lib/articles';
import { assertAffiliateUrl, getPriceTier, PRICE_TIER_RANK } from '../../lib/products';
import { absoluteUrl, itemListSchema } from '../../lib/seo';

export function getStaticPaths() {
	const categories = ['paddles', 'shoes', 'nets', 'balls', 'bags', 'apparel', 'accessories'] as const;
	return categories.map((category) => ({
		params: { category },
	}));
}

const categoryMeta = {
	paddles: {
		h1: 'Best Pickleball Paddles in Canada',
		description:
			'Compare top JOOLA, Selkirk, and Six Zero pickleball paddles popular with Canadian players. Find power, control, and spin options with current store availability.',
		intro:
			'Browse beginner-friendly value paddles through intermediate and tournament frames — sorted from $ to $$$$$ so budget and flagship options are easy to compare.',
	},
	shoes: {
		h1: 'Best Pickleball Shoes in Canada',
		description:
			'Shop court-ready Skechers and ASICS pickleball shoes for Canadian hard courts. Filter by gender and Comfort & Support features like wide fit, arch support, and cushioning.',
		intro:
			'Upgrade from running shoes to court-specific footwear built for lateral cuts, kitchen stops, and long Canadian outdoor sessions. Use Gender and Comfort & Support filters to narrow by fit needs — sorted from $ to $$$$$.',
	},
	nets: {
		h1: 'Best Portable Pickleball Nets in Canada',
		description:
			'Find premium portable pickleball nets for Canadian driveways, parks, and cottage courts. Compare regulation systems from Franklin, ONIX, Rally, and Selkirk.',
		intro:
			'Set up a regulation court anywhere with durable portable nets designed for fast assembly, stable tension, and frequent Canadian outdoor use.',
	},
	balls: {
		h1: 'Best Pickleball Balls in Canada',
		description:
			'Shop outdoor X-40, indoor X-26, ONIX Fuse, and Dura Fast 40 pickleballs for Canadian clubs, gyms, and driveways.',
		intro:
			'Pick indoor or outdoor balls by court surface — tournament favourites and practice packs sorted from $ to $$$$$.',
	},
	bags: {
		h1: 'Best Pickleball Bags in Canada',
		description:
			'Compare sling bags, backpacks, and tour bags for paddles, balls, and club-night gear from JOOLA, Selkirk, and value brands.',
		intro:
			'Carry paddles and accessories to the court with backpacks, slings, and tour bags built for Canadian club and tournament travel.',
	},
	apparel: {
		h1: 'Best Pickleball Apparel in Canada',
		description:
			'Shop skorts, arm sleeves, and court apparel for outdoor Canadian pickleball. Filter by gender and Comfort & Support when those attributes are documented.',
		intro:
			'Dress for outdoor sessions with skorts, UV arm sleeves, and court-ready pieces that move with you at the kitchen. Filter by Gender or Comfort & Support — products stay sorted from $ to $$$$$.',
	},
	accessories: {
		h1: 'Best Pickleball Accessories in Canada',
		description:
			'Overgrips, edge guard tape, and tungsten weighting tape for Canadian paddles — small upgrades that improve feel and durability.',
		intro:
			'Refresh grips, protect edges, and fine-tune swing weight with accessories every regular player eventually needs.',
	},
} as const;

const { category } = Astro.params;
const typedCategory = category as keyof typeof categoryMeta;
const meta = categoryMeta[typedCategory];
const products = gear
	.filter((item) => item.category === typedCategory)
	.slice()
	.sort((a, b) => {
		const tierDiff = PRICE_TIER_RANK[getPriceTier(a.price)] - PRICE_TIER_RANK[getPriceTier(b.price)];
		if (tierDiff !== 0) return tierDiff;
		return a.name.localeCompare(b.name);
	});
const relatedArticles = (
	await getArticlesByCategory(typedCategory as Parameters<typeof getArticlesByCategory>[0])
).slice(0, 3);
const pillar = CATEGORY_PILLARS[typedCategory];
const showGearFilters = typedCategory === 'shoes' || typedCategory === 'apparel';
const categoryOgImage = products[0]?.imageUrl
	? products[0].imageUrl.startsWith('http')
		? products[0].imageUrl
		: absoluteUrl(products[0].imageUrl)
	: undefined;
const itemList = itemListSchema({
	name: meta.h1,
	description: meta.description,
	path: `/gear/${typedCategory}`,
	items: products.map((product, index) => ({
		name: product.name,
		url: assertAffiliateUrl(product.affiliateUrl),
		position: index + 1,
	})),
});
---

<Layout
	title={meta.h1}
	description={meta.description}
	canonicalPath={`/gear/${typedCategory}`}
	ogImage={categoryOgImage}
	jsonLd={itemList}
>
	<section class="border-b border-zinc-200 bg-white">
		<div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
			<Breadcrumbs
				items={[
					{ label: 'Home', href: '/' },
					{ label: 'Gear', href: '/guides' },
					{ label: typedCategory },
				]}
			/>
			<p class="text-sm font-bold uppercase tracking-[0.18em] text-emerald-700">Canadian Gear Guide</p>
			<h1 class="mt-3 max-w-4xl text-4xl font-black tracking-tight text-zinc-900 sm:text-5xl">{meta.h1}</h1>
			<p class="mt-5 max-w-3xl text-lg leading-relaxed text-zinc-600">{meta.intro}</p>
			<p class="mt-4 text-sm font-semibold text-zinc-500">{products.length} products curated for Canadian shoppers</p>
			{pillar && (
				<p class="mt-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-950">
					Start with our pillar guide:
					<a href={pillar.href} class="font-bold underline">{pillar.title}</a>
				</p>
			)}
		</div>
	</section>

	<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
		{showGearFilters && <GearFilters showGender showComfort />}
		{products.length > 0 ? (
			<div id="gear-product-grid" class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
				{products.map((product) => (
					<ProductCard product={product} />
				))}
			</div>
		) : (
			<p class="rounded-2xl border border-dashed border-zinc-300 bg-white p-8 text-center text-zinc-600">
				No products found in this category yet.
			</p>
		)}
		<p
			id="gear-filter-empty"
			class="mt-6 hidden rounded-2xl border border-dashed border-zinc-300 bg-white p-8 text-center text-zinc-600"
		>
			No products match these filters. Clear a Comfort &amp; Support option or switch Gender back to All.
		</p>
	</section>

	{relatedArticles.length > 0 && (
		<section class="border-t border-zinc-200 bg-white">
			<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
				<h2 class="text-2xl font-black tracking-tight text-zinc-900">Related {typedCategory} guides</h2>
				<ul class="mt-6 grid gap-4 md:grid-cols-3">
					{relatedArticles.map((article) => (
						<li>
							<a
								href={`/guides/${article.data.slug}`}
								class="block h-full rounded-2xl border border-zinc-200 p-5 transition hover:border-emerald-200 hover:shadow-md"
							>
								<h3 class="font-bold text-zinc-900">{article.data.title}</h3>
								<p class="mt-2 line-clamp-3 text-sm text-zinc-600">{article.data.description}</p>
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>
	)}
</Layout>
