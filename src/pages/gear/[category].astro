---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import gear from '../../data/gear.json';

export function getStaticPaths() {
	const categories = ['paddles', 'shoes', 'nets'] as const;
	return categories.map((category) => ({
		params: { category },
	}));
}

const categoryMeta = {
	paddles: {
		h1: 'Best Pickleball Paddles in Canada',
		description:
			'Compare top JOOLA, Selkirk, and Six Zero pickleball paddles popular with Canadian players. Find power, control, and spin options with Amazon.ca availability.',
		intro:
			'Browse high-intent paddle picks engineered for Canadian indoor gyms and outdoor acrylic courts — from thermoformed power frames to control-first kitchen weapons.',
	},
	shoes: {
		h1: 'Best Pickleball Shoes in Canada',
		description:
			'Shop court-ready Skechers and ASICS pickleball shoes for Canadian hard courts. Compare traction, lateral support, and comfort for competitive and recreational play.',
		intro:
			'Upgrade from running shoes to court-specific footwear built for lateral cuts, kitchen stops, and long Canadian outdoor sessions.',
	},
	nets: {
		h1: 'Best Portable Pickleball Nets in Canada',
		description:
			'Find premium portable pickleball nets for Canadian driveways, parks, and cottage courts. Compare regulation systems from Franklin, ONIX, Rally, and Selkirk.',
		intro:
			'Set up a regulation court anywhere with durable portable nets designed for fast assembly, stable tension, and frequent Canadian outdoor use.',
	},
} as const;

const { category } = Astro.params;
const typedCategory = category as keyof typeof categoryMeta;
const meta = categoryMeta[typedCategory];
const products = gear.filter((item) => item.category === typedCategory);
---

<Layout title={meta.h1} description={meta.description} canonicalPath={`/gear/${typedCategory}`}>
	<section class="border-b border-zinc-200 bg-white">
		<div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
			<p class="text-sm font-bold uppercase tracking-[0.18em] text-emerald-700">Canadian Gear Guide</p>
			<h1 class="mt-3 max-w-4xl text-4xl font-black tracking-tight text-zinc-900 sm:text-5xl">{meta.h1}</h1>
			<p class="mt-5 max-w-3xl text-lg leading-relaxed text-zinc-600">{meta.intro}</p>
			<p class="mt-4 text-sm font-semibold text-zinc-500">{products.length} products curated for Amazon.ca shoppers</p>
		</div>
	</section>

	<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
		{products.length > 0 ? (
			<div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
				{products.map((product) => (
					<ProductCard product={product} />
				))}
			</div>
		) : (
			<p class="rounded-2xl border border-dashed border-zinc-300 bg-white p-8 text-center text-zinc-600">
				No products found in this category yet.
			</p>
		)}
	</section>
</Layout>
