---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GearFilters from '../../components/GearFilters.astro';
import gear from '../../data/gear.json';
import { getArticlesByCategory, CATEGORY_PILLARS } from '../../lib/articles';
import { getPriceTier, PRICE_TIER_RANK } from '../../lib/products';
import { absoluteUrl, itemListSchema } from '../../lib/seo';
import { MARKET_COUNTRY, MARKET_LABEL } from '../../lib/site';
import { marketizeCopy } from '../../lib/marketCopy';

export function getStaticPaths() {
	const categories = ['paddles', 'shoes', 'nets', 'balls', 'bags', 'apparel', 'accessories'] as const;
	return categories.map((category) => ({
		params: { category },
	}));
}

const categoryMeta = {
	paddles: {
		h1: 'Best Pickleball Paddles (2026)',
		description:
			'Best pickleball paddles for 2026 by job: control, power, spin, or budget. JOOLA, Selkirk, and Six Zero — price tiers only, confirm the live Amazon price.',
		quickAnswer:
			'There is no single best pickleball paddle. Pick by the miss: soft hands (control), put-away pace (power), or a first frame under flagship money (budget or hybrid). This catalog sorts $ to $$$$$. Confirm the live model on Amazon.com.',
		intro:
			'Browse value paddles through tournament frames — sorted from $ to $$$$$ so a first paddle and a flagship are easy to tell apart. Price badges are relative bands, not live cart totals.',
		links: [
			{ href: '/guides/best-pickleball-paddles-2026', label: '2026 picks by playing style' },
			{ href: '/guides/best-budget-pickleball-paddles', label: 'Budget paddles' },
			{ href: '/guides/best-hybrid-pickleball-paddles', label: 'Hybrid paddles' },
			{ href: '/guides/how-to-choose-a-pickleball-paddle', label: 'How to choose' },
		],
	},
	shoes: {
		h1: 'Best Pickleball Shoes (2026)',
		description:
			'Best pickleball shoes for hard-court cuts: Skechers Viper Court vs ASICS Gel. Court shoes, not running shoes. Confirm the live price on Amazon.',
		quickAnswer:
			'Wear court shoes, not running shoes. Skechers Viper Court leans cushion and an easier break-in. ASICS Gel-Dedicate and Gel-Resolution lean structured lateral support. Filter by gender and fit, then confirm the live size on Amazon.com.',
		intro:
			'Court shoes for lateral cuts, kitchen stops, and outdoor hard courts. Use Gender and Comfort & Support filters to narrow fit — products stay sorted from $ to $$$$$.',
		links: [
			{ href: '/guides/best-pickleball-shoes-2026', label: '2026 shoe picks' },
			{ href: '/guides/skechers-vs-asics-pickleball', label: 'Skechers vs ASICS' },
			{ href: '/guides/best-pickleball-shoes-for-wide-feet', label: 'Wide feet' },
			{ href: '/guides/best-pickleball-shoes-for-plantar-fasciitis', label: 'Plantar fasciitis' },
		],
	},
	nets: {
		h1: `Best Portable Pickleball Nets in ${MARKET_COUNTRY}`,
		description: `Find premium portable pickleball nets for ${MARKET_LABEL} driveways, parks, and backyard courts. Compare regulation systems from Franklin, ONIX, Rally, and Selkirk.`,
		intro: `Set up a regulation court anywhere with durable portable nets designed for fast assembly, stable tension, and frequent ${MARKET_LABEL} outdoor use.`,
	},
	balls: {
		h1: `Best Pickleball Balls in ${MARKET_COUNTRY}`,
		description: `Shop outdoor X-40, indoor X-26, ONIX Fuse, and Dura Fast 40 pickleballs for ${MARKET_LABEL} clubs, gyms, and driveways.`,
		intro:
			'Pick indoor or outdoor balls by court surface — tournament favourites and practice packs sorted from $ to $$$$$.',
	},
	bags: {
		h1: 'Best Pickleball Bags (2026)',
		description:
			'Compare pickleball bags by what you carry: sling, backpack, or tour. JOOLA, Selkirk, and Mangrove layouts — confirm the live Amazon price.',
		quickAnswer:
			'Match the bag to the load. A sling is one paddle plus balls. A backpack adds shoes and a second paddle. A tour bag is for several paddles and a full match day. This catalog lists Mangrove ($$), JOOLA Tour Elite ($$), and the Selkirk Team backpack ($$$$$).',
		intro:
			'Sling, backpack, or tour bag — pick from what you actually carry to open play, not from the logo. Sorted from $ to $$$$$. Capacity claims below are the lines printed in the catalog.',
		links: [
			{ href: '/guides/pickleball-bags-buying-guide', label: 'Bag buying guide' },
			{ href: '/gear/paddles', label: 'Paddles to pack' },
			{ href: '/gear/shoes', label: 'Court shoes' },
			{ href: '/guides/pickleball-accessories-buying-guide', label: 'Grips and accessories' },
		],
	},
	apparel: {
		h1: `Best Pickleball Apparel in ${MARKET_COUNTRY}`,
		description: `Shop skorts, arm sleeves, and court apparel for outdoor ${MARKET_LABEL} pickleball. Filter by gender and Comfort & Support when those attributes are documented.`,
		intro:
			'Dress for outdoor sessions with skorts, UV arm sleeves, and court-ready pieces that move with you at the kitchen. Filter by Gender or Comfort & Support — products stay sorted from $ to $$$$$.',
	},
	accessories: {
		h1: `Best Pickleball Accessories in ${MARKET_COUNTRY}`,
		description: `Overgrips, edge guard tape, and tungsten weighting tape for ${MARKET_LABEL} paddles — small upgrades that improve feel and durability.`,
		intro:
			'Refresh grips, protect edges, and fine-tune swing weight with accessories every regular player eventually needs.',
	},
} as const;

const { category } = Astro.params;
const typedCategory = category as keyof typeof categoryMeta;
const meta = categoryMeta[typedCategory];
const products = gear
	.filter((item) => item.category === typedCategory)
	.slice()
	.sort((a, b) => {
		const tierDiff = PRICE_TIER_RANK[getPriceTier(a.price)] - PRICE_TIER_RANK[getPriceTier(b.price)];
		if (tierDiff !== 0) return tierDiff;
		return a.name.localeCompare(b.name);
	});
const relatedArticles = (
	await getArticlesByCategory(typedCategory as Parameters<typeof getArticlesByCategory>[0])
).slice(0, 3);
const pillar = CATEGORY_PILLARS[typedCategory];
const showGearFilters = typedCategory === 'shoes' || typedCategory === 'apparel';
const categoryOgImage = products[0]?.imageUrl
	? products[0].imageUrl.startsWith('http')
		? products[0].imageUrl
		: absoluteUrl(products[0].imageUrl)
	: undefined;
const itemList = itemListSchema({
	name: meta.h1,
	description: meta.description,
	path: `/gear/${typedCategory}`,
	items: products.map((product, index) => ({
		name: product.name,
		url: absoluteUrl(`/gear/${typedCategory}#${product.id}`),
		position: index + 1,
		brand: product.brand,
		description: marketizeCopy(product.description),
		image: product.imageUrl.startsWith('http')
			? product.imageUrl
			: absoluteUrl(product.imageUrl),
	})),
});
---

<Layout
	title={'title' in meta && meta.title ? meta.title : meta.h1}
	description={meta.description}
	canonicalPath={`/gear/${typedCategory}`}
	ogImage={categoryOgImage}
	jsonLd={itemList}
>
	<section class="border-b border-zinc-200 bg-white">
		<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
			<Breadcrumbs
				items={[
					{ label: 'Home', href: '/' },
					{ label: 'Gear' },
					{ label: typedCategory },
				]}
			/>
			<p class="text-sm font-bold uppercase tracking-[0.18em] text-emerald-800">{MARKET_LABEL} Gear Guide</p>
			<h1 class="mt-3 max-w-4xl text-4xl font-black tracking-tight text-zinc-900 sm:text-5xl">{meta.h1}</h1>
			{'quickAnswer' in meta && meta.quickAnswer && (
				<div class="mt-5 max-w-3xl rounded-2xl border border-emerald-200 bg-emerald-50/70 px-5 py-4">
					<p class="text-xs font-bold uppercase tracking-[0.14em] text-emerald-800">Quick answer</p>
					<p class="mt-2 text-base leading-relaxed text-emerald-950">{meta.quickAnswer}</p>
				</div>
			)}
			<p class="mt-5 max-w-3xl text-lg leading-relaxed text-zinc-600">{meta.intro}</p>
			{'links' in meta && meta.links && (
				<ul class="mt-4 flex max-w-3xl flex-wrap gap-2">
					{meta.links.map((link) => (
						<li>
							<a
								href={link.href}
								class="inline-flex rounded-full border border-emerald-200 bg-white px-3 py-1 text-sm font-semibold text-emerald-900 underline-offset-2 hover:underline"
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			)}
			<p class="mt-4 text-sm font-semibold text-zinc-500">
				{products.length} products curated for {MARKET_LABEL} shoppers
				{' · '}
				<a href="#gear-product-grid" class="font-bold text-emerald-800 underline">Jump to shop</a>
			</p>
			{pillar && (
				<p class="mt-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-950">
					Start with our pillar guide:
					<a href={pillar.href} class="font-bold underline">{pillar.title}</a>
				</p>
			)}
		</div>
	</section>

	<section class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
		{showGearFilters && <GearFilters showGender showComfort />}
		{products.length > 0 ? (
			<div id="gear-product-grid" class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
				{products.map((product, index) => (
					<article>
						<h2 class="sr-only">{product.name}</h2>
						<ProductCard product={product} priority={index === 0} />
					</article>
				))}
			</div>
		) : (
			<p class="rounded-2xl border border-dashed border-zinc-300 bg-white p-8 text-center text-zinc-600">
				No products found in this category yet.
			</p>
		)}
		<p
			id="gear-filter-empty"
			class="mt-6 hidden rounded-2xl border border-dashed border-zinc-300 bg-white p-8 text-center text-zinc-600"
		>
			No products match these filters. Clear a Comfort &amp; Support option or switch Gender back to All.
		</p>
	</section>

	{relatedArticles.length > 0 && (
		<section class="border-t border-zinc-200 bg-white">
			<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
				<h2 class="text-2xl font-black tracking-tight text-zinc-900">Related {typedCategory} guides</h2>
				<ul class="mt-6 grid gap-4 md:grid-cols-3">
					{relatedArticles.map((article) => (
						<li>
							<a
								href={`/guides/${article.data.slug}`}
								class="block h-full rounded-2xl border border-zinc-200 p-5 transition hover:border-emerald-200 hover:shadow-md"
							>
								<h3 class="font-bold text-zinc-900">{article.data.title}</h3>
								<p class="mt-2 line-clamp-3 text-sm text-zinc-600">{marketizeCopy(article.data.description)}</p>
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>
	)}
</Layout>
