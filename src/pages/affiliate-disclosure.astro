---
import TrustPageLayout from '../layouts/TrustPageLayout.astro';
import Disclosure from '../components/Disclosure.astro';
import { AFFILIATE_TAG, AMAZON_LABEL, SITE_NAME } from '../lib/site';
---

<TrustPageLayout
	title="Affiliate Disclosure"
	description={`Full FTC and Amazon Associates disclosure for ${SITE_NAME}.`}
	canonicalPath="/affiliate-disclosure"
>
	<Disclosure />
	<h2>Amazon Associates</h2>
	<p>
		{SITE_NAME} is a participant in the Amazon Services LLC Associates Program, an affiliate advertising
		program designed to provide a means for sites to earn advertising fees by advertising and linking to {AMAZON_LABEL}
		and affiliated sites.
	</p>
	<p>
		When you click an Amazon link on this site and complete a qualifying purchase, we may earn a commission at no
		additional cost to you. Our Amazon Associates tag is <code>{AFFILIATE_TAG}</code>.
	</p>
	<h2>FTC disclosure</h2>
	<p>
		In accordance with the U.S. Federal Trade Commission’s guidelines concerning the use of endorsements and
		testimonials in advertising, and applicable marketing disclosure expectations, we disclose material connections —
		including affiliate commissions — clearly on pages that contain affiliate links.
	</p>
	<h2>Pricing note</h2>
	<p>
		Any prices shown on this site are approximate catalog references only and may be outdated. Amazon’s price and
		availability information is authoritative. Use “Check current price on Amazon” links before buying.
	</p>
</TrustPageLayout>
