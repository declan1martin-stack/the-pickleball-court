---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SmartImage from '../../components/SmartImage.astro';
import { getAllArticles } from '../../lib/articles';
import { MARKET_LABEL, MARKET_PLAYERS } from '../../lib/site';
import { marketizeCopy } from '../../lib/marketCopy';
import { getLatestGearPost, newsPath } from '../../lib/news';

const allArticles = await getAllArticles();
const latestGear = await getLatestGearPost();
const latestGearHref = latestGear ? newsPath(latestGear) : '/news';
const categories = [
	'all',
	'paddles',
	'shoes',
	'nets',
	'balls',
	'bags',
	'apparel',
	'accessories',
	'guides',
	'rules',
] as const;
---

<Layout
	title="Pickleball Guides & Buying Advice"
	description={`In-depth ${MARKET_LABEL} pickleball buying guides, comparisons, and rules explainers for paddles, shoes, balls, bags, apparel, accessories, and portable nets.`}
	canonicalPath="/guides"
>
	<section class="border-b border-zinc-200 bg-white">
		<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
			<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Guides' }]} />
			<h1 class="text-4xl font-black tracking-tight text-zinc-900 sm:text-5xl">Pickleball Guides</h1>
			<p class="mt-4 max-w-3xl text-lg text-zinc-600">
				Practical buying advice and rules explainers for {MARKET_PLAYERS} — from first paddle to tournament prep.
			</p>
			<p class="mt-4 max-w-3xl text-sm text-zinc-600">
				For short, dated industry notes — MLP/PPA, CNPL, Nationals, and paddle launches — see our
				<a href="/news" class="font-semibold text-emerald-800 underline">news & weekly updates</a>, including the latest
				<a href={latestGearHref} class="font-semibold text-emerald-800 underline">gear roundup</a>.
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
		<div class="flex flex-wrap gap-2" role="list" aria-label="Filter guides by category">
			{categories.map((category) => (
				<button
					type="button"
					role="listitem"
					data-filter={category}
					class="guide-filter rounded-full px-4 py-2 text-sm font-semibold transition bg-white text-zinc-700 ring-1 ring-zinc-200 hover:ring-emerald-300 aria-[current=page]:bg-emerald-700 aria-[current=page]:text-white aria-[current=page]:ring-emerald-700"
					aria-current={category === 'all' ? 'page' : undefined}
				>
					{category === 'all' ? 'All' : category}
				</button>
			))}
		</div>

		{allArticles.length > 0 ? (
			<ul id="guides-grid" class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
				{allArticles.map((article) => (
					<li data-category={article.data.category}>
						<a
							href={`/guides/${article.data.slug}`}
							class="flex h-full flex-col overflow-hidden rounded-2xl border border-zinc-200 bg-white transition hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-md"
						>
							<SmartImage
								src={article.data.heroImage}
								alt={article.data.heroAlt}
								width={800}
								height={450}
								loading="lazy"
								decoding="async"
								class="aspect-[16/9] w-full object-cover"
							/>
							<div class="flex flex-1 flex-col p-5">
								<p class="text-xs font-bold uppercase tracking-wider text-emerald-800">
									{article.data.category} · {article.data.type}
								</p>
								<h2 class="mt-2 text-lg font-bold text-zinc-900">{article.data.title}</h2>
								<p class="mt-2 line-clamp-3 text-sm text-zinc-600">{marketizeCopy(article.data.description)}</p>
								<p class="mt-auto pt-4 text-xs font-semibold text-zinc-500">
									Updated {article.data.updatedDate.toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: 'numeric' })}
								</p>
							</div>
						</a>
					</li>
				))}
			</ul>
		) : (
			<p class="mt-10 rounded-2xl border border-dashed border-zinc-300 bg-white p-8 text-center text-zinc-600">
				Guides are loading into the library — check back soon, or browse
				<a href="/gear/paddles" class="font-semibold text-emerald-800 underline">paddle gear</a>.
			</p>
		)}

		<p id="guides-empty" class="mt-10 hidden rounded-2xl border border-dashed border-zinc-300 bg-white p-8 text-center text-zinc-600">
			No guides in this category yet.
		</p>
	</section>

	<script>
		const buttons = document.querySelectorAll<HTMLButtonElement>('.guide-filter');
		const items = document.querySelectorAll<HTMLElement>('#guides-grid > li');
		const empty = document.getElementById('guides-empty');

		function applyFilter(category: string) {
			let visible = 0;
			items.forEach((item) => {
				const match = category === 'all' || item.dataset.category === category;
				item.classList.toggle('hidden', !match);
				if (match) visible += 1;
			});
			buttons.forEach((button) => {
				button.setAttribute('aria-current', button.dataset.filter === category ? 'page' : 'false');
			});
			empty?.classList.toggle('hidden', visible > 0 || items.length === 0);
			const url = new URL(window.location.href);
			if (category === 'all') url.searchParams.delete('category');
			else url.searchParams.set('category', category);
			history.replaceState({}, '', url);
		}

		buttons.forEach((button) => {
			button.addEventListener('click', () => applyFilter(button.dataset.filter || 'all'));
		});

		const initial = new URLSearchParams(window.location.search).get('category') || 'all';
		applyFilter(initial);
	</script>
</Layout>
