---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Disclosure from '../../components/Disclosure.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import FAQ from '../../components/FAQ.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import ProductSpotlight from '../../components/ProductSpotlight.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import ProsCons from '../../components/ProsCons.astro';
import Callout from '../../components/Callout.astro';
import {
	getAllArticles,
	getRelatedArticles,
	categoryPath,
} from '../../lib/articles';
import { absoluteUrl, articleSchema } from '../../lib/seo';
import { getProductById, isPriceTier } from '../../lib/products';
import { authorPath, resolveAuthor } from '../../data/authors';

export async function getStaticPaths() {
	const articles = await getCollection('articles');
	return articles.map((article) => ({
		params: { slug: article.data.slug },
		props: { article },
	}));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const allArticles = await getAllArticles();
const related = getRelatedArticles(allArticles, article, 3);
const categoryHref = categoryPath(article.data.category);
const path = `/guides/${article.data.slug}`;
const author = resolveAuthor(article.data.author);
const mdxComponents = {
	AffiliateButton,
	ComparisonTable,
	ProsCons,
	Callout,
	ProductSpotlight,
};
const relatedProductLinks = article.data.relatedProducts
	.map((id) => getProductById(id))
	.filter(Boolean);

const crumbs = [
	{ label: 'Home', href: '/' },
	{ label: 'Guides', href: '/guides' },
	...(categoryHref
		? [{ label: article.data.category, href: categoryHref }]
		: [{ label: article.data.category, href: `/guides?category=${article.data.category}` }]),
	{ label: article.data.title },
];
---

<Layout
	title={article.data.title}
	description={article.data.description}
	canonicalPath={path}
	ogImage={article.data.heroImage}
	ogType="article"
	publishDate={article.data.publishDate}
	updatedDate={article.data.updatedDate}
	jsonLd={articleSchema({
		title: article.data.title,
		description: article.data.description,
		path,
		image: article.data.heroImage,
		author: author.name,
		authorUrl: absoluteUrl(authorPath(author.id)),
		publishDate: article.data.publishDate,
		updatedDate: article.data.updatedDate,
	})}
>
	<article class="border-b border-zinc-200 bg-white">
		<div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
			<Breadcrumbs items={crumbs} />
			<p class="text-sm font-bold uppercase tracking-[0.18em] text-emerald-700">
				{article.data.type.replace('-', ' ')} · {article.data.category}
			</p>
			<h1 class="mt-3 max-w-4xl text-4xl font-black tracking-tight text-zinc-900 sm:text-5xl">
				{article.data.title}
			</h1>
			<p class="mt-4 max-w-3xl text-lg text-zinc-600">{article.data.description}</p>
			<p class="mt-4 text-sm text-zinc-500">
				By <a href={authorPath(author.id)} class="font-semibold text-emerald-700 underline">{author.name}</a>
				<span aria-hidden="true"> · </span>
				Published {article.data.publishDate.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' })}
				<span aria-hidden="true"> · </span>
				Last updated {article.data.updatedDate.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' })}
			</p>
			<img
				src={article.data.heroImage}
				alt={article.data.heroAlt}
				width="1200"
				height="630"
				class="mt-8 aspect-[21/9] w-full rounded-2xl object-cover object-[center_35%]"
			/>
		</div>
	</article>

	<div class="mx-auto grid max-w-7xl gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_260px] lg:px-8">
		<div class="min-w-0">
			<Disclosure />

			{/* Answer-first summary for AI/snippet extraction — uses the page description as the direct takeaway. */}
			<div class="mt-6 max-w-[70ch] rounded-2xl border border-emerald-200 bg-emerald-50/70 px-5 py-4">
				<p class="text-xs font-bold uppercase tracking-[0.14em] text-emerald-800">Quick answer</p>
				<p class="mt-2 text-base leading-relaxed text-emerald-950">{article.data.description}</p>
			</div>

			{categoryHref && (
				<p class="mt-6 text-sm text-zinc-600">
					Shopping gear?
					<a href={categoryHref} class="font-semibold text-emerald-700 underline">
						Browse our {article.data.category} catalog
					</a>
					for current store availability.
				</p>
			)}

			<div
				class="prose-article mt-8 max-w-[70ch] text-zinc-800 [&_a]:font-semibold [&_a]:text-emerald-700 [&_a]:underline [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-black [&_h2]:tracking-tight [&_h2]:text-zinc-900 [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-zinc-900 [&_li]:my-1 [&_ol]:my-4 [&_ol]:list-decimal [&_ol]:pl-5 [&_p]:my-4 [&_p]:leading-relaxed [&_ul]:my-4 [&_ul]:list-disc [&_ul]:pl-5"
			>
				<Content components={mdxComponents} />
			</div>

			{relatedProductLinks.length > 0 && (
				<section class="mt-10" aria-labelledby="guide-products-heading">
					<h2 id="guide-products-heading" class="text-2xl font-black text-zinc-900">Products mentioned</h2>
					<ul class="mt-4 space-y-3">
						{relatedProductLinks.map((product) => (
							<li class="flex flex-col gap-2 rounded-xl border border-zinc-200 bg-zinc-50 p-4 sm:flex-row sm:items-center sm:justify-between">
								<div>
									<p class="font-bold text-zinc-900">{product.name}</p>
									<p class="text-xs text-zinc-500">
										{isPriceTier(product.price)
											? `Approx. price tier ${product.price} — confirm current store price`
											: `Approx. listed: ${product.price} — confirm current store price`}
									</p>
								</div>
								<AffiliateButton href={product.affiliateUrl} productId={product.id} variant="secondary" label="Check current price" />
							</li>
						))}
					</ul>
				</section>
			)}

			{article.data.relatedProducts[0] && (
				<ProductSpotlight productId={article.data.relatedProducts[0]} eyebrow="Featured from this guide" />
			)}

			<FAQ items={article.data.faq} />
			<AuthorBox author={author} />
			<RelatedArticles
				articles={related.map((item) => ({
					slug: item.data.slug,
					title: item.data.title,
					description: item.data.description,
					category: item.data.category,
				}))}
			/>
		</div>

		<aside class="hidden lg:block">
			<TableOfContents headings={headings} />
		</aside>
	</div>
</Layout>
