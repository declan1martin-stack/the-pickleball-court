{
  "name": "the-pickleball-court",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run qa:news && PUBLIC_SITE_REGION=us astro build",
    "build:ca": "npm run qa:news && PUBLIC_SITE_REGION=ca astro build",
    "build:us": "npm run qa:news && PUBLIC_SITE_REGION=us astro build",
    "preview": "astro preview",
    "check": "astro check",
    "qa:news": "node scripts/qa-news-images.mjs",
    "qa:affiliate": "node scripts/qa-affiliate.mjs",
    "qa:affiliate:ca": "PUBLIC_SITE_REGION=ca node scripts/qa-affiliate.mjs",
    "qa:affiliate:us": "PUBLIC_SITE_REGION=us node scripts/qa-affiliate.mjs",
    "qa:live": "node scripts/qa-live.mjs",
    "qa:live:ca": "LIVE_SITE=https://thepickleballcourt.ca PUBLIC_SITE_REGION=ca node scripts/qa-live.mjs",
    "qa:live:us": "LIVE_SITE=https://uspickleballcourt.com PUBLIC_SITE_REGION=us node scripts/qa-live.mjs",
    "ping:indexnow": "node scripts/ping-indexnow.mjs --both",
    "ping:indexnow:us": "PUBLIC_SITE_REGION=us node scripts/ping-indexnow.mjs --host=uspickleballcourt.com",
    "ping:indexnow:ca": "PUBLIC_SITE_REGION=ca node scripts/ping-indexnow.mjs --host=thepickleballcourt.ca"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/sora": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
